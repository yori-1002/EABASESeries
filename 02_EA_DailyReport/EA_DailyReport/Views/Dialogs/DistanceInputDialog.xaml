<Window x:Class="EA_DailyReport.Views.Dialogs.DistanceInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="距離入力"
        Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F7FA">
    <!-- ▼ 新規作成 v0.1.13：
         InputDialog の MAP ボタン押下時に、Google Maps 起動と同時に表示される
         距離入力サブダイアログ。
         ・Google Maps で確認した距離を整数 km で入力 → InputDialog の txt_distance に転記
         ・キャンセル時は txt_distance を変更しない（あとで手入力する想定）
         ・初期値として呼出元の txt_distance.Text を表示（変更しない場合はそのまま OK） -->

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- タイトル -->
            <RowDefinition Height="*"/>
            <!-- 入力エリア -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ===== タイトル ===== -->
        <TextBlock Grid.Row="0"
                   Text="🗺 距離入力"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#222B45"
                   Margin="0,0,0,12"/>

        <!-- ===== 入力エリア ===== -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E1E5EA"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14,12"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Google Maps で確認した距離を入力してください。"
                           FontSize="12"
                           Foreground="#444"
                           Margin="0,0,0,4"/>
                <TextBlock Text="（整数 km・小数は自動で四捨五入されます）"
                           FontSize="11"
                           Foreground="#888"
                           Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBox x:Name="txt_distance_input"
                             Width="120"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Padding="8,6"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             ToolTip="数値を入力（例：13、12.7 など）"/>
                    <TextBlock Text=" km"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="#555"
                               Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Footer ===== -->
        <Grid Grid.Row="2">
            <TextBlock Text="💡 Enter で OK / Esc でキャンセル"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Foreground="#888"
                       FontSize="11"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="btn_cancel"
                        Content="キャンセル"
                        Width="100"
                        Padding="0,7"
                        Margin="0,0,8,0"
                        Background="#F5F5F5"
                        Foreground="#333"
                        BorderBrush="#CCC"
                        BorderThickness="1"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="btn_cancel_Click"/>
                <Button x:Name="btn_ok"
                        Content="OK"
                        Width="100"
                        Padding="0,7"
                        Background="#4A90E2"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="btn_ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
