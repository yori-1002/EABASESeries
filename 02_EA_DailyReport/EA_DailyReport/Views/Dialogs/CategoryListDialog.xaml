<Window x:Class="EA_DailyReport.Views.Dialogs.CategoryListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="区分リスト"
        Height="500" Width="620"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <!-- ▼ 新規作成 v0.1.12 Phase 2：
         InputDialog の「区分リスト」ボタンから呼び出されるサブダイアログ。
         projects テーブル(is_active=1)の一覧を検索・絞り込み・選択する。
         レイアウト：検索テキストボックス + ListView + キャンセルボタンのみ。
         「ダブルクリックで即選択」のスピード重視 UX。 -->

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- タイトル -->
            <RowDefinition Height="Auto"/>
            <!-- 検索エリア -->
            <RowDefinition Height="*"/>
            <!-- 一覧 -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ===== タイトル ===== -->
        <TextBlock Grid.Row="0"
                   Text="区分リスト"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#222B45"
                   Margin="0,0,0,12"/>

        <!-- ===== 検索エリア ===== -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E1E5EA"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="🔍 検索（区分コード・区分詳細を全文検索）"
                           FontSize="11"
                           Foreground="#666"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="txt_search"
                         Padding="6,4"
                         FontSize="13"
                         TextChanged="txt_search_changed"
                         ToolTip="入力すると一覧が即座にフィルタリングされる"/>
            </StackPanel>
        </Border>

        <!-- ===== 一覧 ListView ===== -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E1E5EA"
                BorderThickness="1"
                CornerRadius="4">
            <ListView x:Name="lst_categories"
                      BorderThickness="0"
                      Background="White"
                      MouseDoubleClick="lst_categories_DoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <!-- 区分コード -->
                        <GridViewColumn Header="区分コード" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding category_code}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- 区分詳細（company_name = 正式工事名） -->
                        <GridViewColumn Header="区分詳細" Width="430">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding company_name}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="#555"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- ===== Footer ===== -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="💡 ヒント：行をダブルクリックで即選択"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Foreground="#888"
                       FontSize="11"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="btn_cancel"
                        Content="キャンセル"
                        Padding="18,7"
                        Background="#F5F5F5"
                        Foreground="#333"
                        BorderBrush="#CCC"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="btn_cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
