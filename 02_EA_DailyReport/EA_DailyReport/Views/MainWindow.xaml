<Window x:Class="EA_DailyReport.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EA_DailyReport.Views"
        mc:Ignorable="d"
        Title="EA_DailyReport"
        Height="720" Width="1320"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource brush_bg_main}">

    <!-- ▼ 修正：v0.1.7 C方針レイアウト全面改修
         ・ヘッダーバー削除（サイドバーがウィンドウ全高に伸びる）
         ・サイドバー幅 200 → 240px・ロゴエリア・クイックエリア・月度ツリー追加
         ・同期/最新取得ボタンはサイドバー下部に配置
         ・ユーザー名表示はロゴエリア下部
         ・カラーは Styles.xaml の brush_primary（アイコン青基準）を継承 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== メインエリア：サイドバー + コンテンツ ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== サイドバー（紺背景・全画面高さ） ===== -->
            <Border Grid.Column="0"
                    Background="{StaticResource brush_primary}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===== ① ロゴエリア ===== -->
                    <Border Grid.Row="0"
                            Padding="16,18,16,16"
                            BorderBrush="{StaticResource brush_primary_light}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- アイコン表示（Assets配置済みを想定） -->
                                <Image x:Name="img_app_icon"
                                       Width="32" Height="32"
                                       Source="/Assets/daily_report.ico"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="EA_DailyReport"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock x:Name="txt_version"
                                               Text="EABASE Series v1.0.0"
                                               FontSize="10"
                                               Foreground="#BDC3C7"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- ユーザー名表示（ロゴ下） -->
                            <Border Background="{StaticResource brush_primary_light}"
                                    CornerRadius="4"
                                    Padding="8,5"
                                    Margin="0,12,0,0">
                                <TextBlock x:Name="txt_user"
                                           Text="👤 ゲスト"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== ② クイックエリア ===== -->
                    <StackPanel Grid.Row="1" Margin="12,14,12,4">
                        <TextBlock Text="クイック"
                                   Foreground="#7F8C8D"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,6"/>
                        <Button x:Name="btn_quick_this_month"
                                Content="📅  今月の日報"
                                Style="{StaticResource style_sidebar_quick_button}"
                                Click="btn_quick_this_month_Click"
                                ToolTip="あなたの今月度の日報一覧を表示します"/>
                    </StackPanel>

                    <!-- 区切り線 -->
                    <Border Grid.Row="2"
                            Margin="12,12,12,0"
                            Height="1"
                            Background="{StaticResource brush_primary_light}"/>

                    <!-- ===== ③ メニュー（ナビゲーション + 月度ツリー） ===== -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,8">
                            <TextBlock Text="メニュー"
                                       Foreground="#7F8C8D"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="16,4,0,4"/>

                            <Button x:Name="btn_nav_dashboard"
                                    Content="🏠   ダッシュボード"
                                    Style="{StaticResource style_sidebar_button}"
                                    Click="btn_nav_dashboard_Click"/>
                            <Button x:Name="btn_nav_daily_report"
                                    Content="📋   日報一覧"
                                    Style="{StaticResource style_sidebar_button}"
                                    Click="btn_nav_daily_report_Click"/>

                            <!-- 月度ツリー（年度→月度展開） -->
                            <TreeView x:Name="tree_months"
                                      Style="{StaticResource style_month_tree}"
                                      ItemContainerStyle="{StaticResource style_month_tree_item}"
                                      Margin="34,0,8,4"
                                      SelectedItemChanged="tree_months_SelectedItemChanged"/>

                            <Button x:Name="btn_nav_attendance"
                                    Content="📊   出面表"
                                    Style="{StaticResource style_sidebar_button}"
                                    Click="btn_nav_attendance_Click"/>
                            <Button x:Name="btn_nav_settings"
                                    Content="⚙️   設定"
                                    Style="{StaticResource style_sidebar_button}"
                                    Click="btn_nav_settings_Click"/>
                            <Button x:Name="btn_nav_help"
                                    Content="❓   ヘルプ"
                                    Style="{StaticResource style_sidebar_button}"
                                    Click="btn_nav_help_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== ④ サイドバー下部（同期・最新取得ボタン） ===== -->
                    <Border Grid.Row="4"
                            Padding="12,10"
                            BorderBrush="{StaticResource brush_primary_light}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Button x:Name="btn_sync"
                                    Content="🔄 同期"
                                    Style="{StaticResource style_button_primary}"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,8"
                                    FontSize="12"
                                    Click="btn_sync_Click"
                                    ToolTip="ローカルの未同期データをNASに反映します"/>
                            <Button x:Name="btn_refresh"
                                    Content="🔄 最新を取得"
                                    Style="{StaticResource style_button_primary}"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,8"
                                    FontSize="12"
                                    Margin="0,6,0,0"
                                    Click="btn_refresh_Click"
                                    ToolTip="NASから最新データを取得して画面を更新します"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== コンテンツエリア（ページ表示用 Frame） ===== -->
            <Frame x:Name="content_frame"
                   Grid.Column="1"
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource brush_bg_main}"/>
        </Grid>

        <!-- ===== ステータスバー ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource brush_bg_card}"
                BorderBrush="{StaticResource brush_border}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock x:Name="txt_status"
                       Text="最終同期：未実行 / 未同期：0件 / 最終取得：未実行"
                       FontSize="11"
                       Foreground="{StaticResource brush_text_secondary}"/>
        </Border>
    </Grid>
</Window>
