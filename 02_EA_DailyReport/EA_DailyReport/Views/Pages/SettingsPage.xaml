<Page x:Class="EA_DailyReport.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="設定"
      Background="{StaticResource brush_bg_main}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== ページタイトル ===== -->
            <TextBlock Grid.Row="0"
                       Text="⚙️ 設定"
                       Style="{StaticResource style_page_title}"/>

            <!-- ===== ① DB 接続設定 ===== -->
            <Border Grid.Row="1"
                    Style="{StaticResource style_card}"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📂 DB 接続設定"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource brush_text_primary}"
                               Margin="0,0,0,12"/>

                    <!-- モード選択 -->
                    <TextBlock Text="モード"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource brush_text_primary}"
                               Margin="0,0,0,6"/>
                    <Border Background="{StaticResource brush_bg_main}"
                            CornerRadius="6"
                            Padding="14,12"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <RadioButton x:Name="rad_mode_production"
                                         GroupName="db_mode"
                                         Content="本番モード（NAS共有DB・通常運用）"
                                         FontSize="13"
                                         IsChecked="True"
                                         Margin="0,0,0,4"/>
                            <RadioButton x:Name="rad_mode_test"
                                         GroupName="db_mode"
                                         Content="テストモード（指定DB・ローカルDBもテスト用に分離）"
                                         FontSize="13"
                                         Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 本番 NAS DB パス -->
                    <TextBlock Text="📁 本番 NAS DB パス"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource brush_text_primary}"
                               Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txt_nas_path_production"
                                 Grid.Column="0"
                                 Padding="8,6"
                                 FontSize="12"
                                 FontFamily="Consolas"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="参照…"
                                Padding="14,6"
                                Margin="6,0,0,0"
                                Background="{StaticResource brush_bg_card}"
                                BorderBrush="{StaticResource brush_border}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="btn_browse_production_Click"/>
                    </Grid>

                    <!-- テスト DB パス -->
                    <TextBlock Text="📁 テスト DB パス"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource brush_text_primary}"
                               Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txt_nas_path_test"
                                 Grid.Column="0"
                                 Padding="8,6"
                                 FontSize="12"
                                 FontFamily="Consolas"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="参照…"
                                Padding="14,6"
                                Margin="6,0,0,0"
                                Background="{StaticResource brush_bg_card}"
                                BorderBrush="{StaticResource brush_border}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="btn_browse_test_Click"/>
                    </Grid>

                    <!-- 注意書き -->
                    <Border Background="#FEF3C7"
                            BorderBrush="{StaticResource brush_warning}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💡 設定の反映について"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource brush_warning}"
                                       FontSize="12"/>
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource brush_text_primary}"
                                       Margin="0,4,0,0">
                                モード切替や DB パス変更は、アプリ再起動後に反映されます。<LineBreak/>
                                「💾 保存して再起動」を押すと自動で再起動します。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 操作ボタン -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btn_test_connection"
                                Content="🔌 接続テスト"
                                Padding="14,8"
                                FontSize="12"
                                Background="{StaticResource brush_bg_card}"
                                BorderBrush="{StaticResource brush_border}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="btn_test_connection_Click"
                                ToolTip="現在選択中のモードのDBパスへ接続できるかテストします"/>
                        <Button x:Name="btn_save_and_restart"
                                Content="💾 保存して再起動"
                                Style="{StaticResource style_button_primary}"
                                Margin="10,0,0,0"
                                Click="btn_save_and_restart_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== ② その他の設定（プレースホルダー）===== -->
            <Border Grid.Row="2"
                    Style="{StaticResource style_card}">
                <StackPanel>
                    <TextBlock Text="🎨 表示設定"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource brush_text_primary}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="カラーテーマやフォントサイズの変更は次 Sprint で実装予定です。"
                               Foreground="{StaticResource brush_text_secondary}"
                               FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
