<Page x:Class="EA_DailyReport.Views.Pages.DailyReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="日報一覧"
      Background="{StaticResource brush_bg_main}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ページタイトル＋新規ボタン ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="txt_page_title"
                       Text="日報一覧"
                       Style="{StaticResource style_page_title}"
                       VerticalAlignment="Center"
                       Margin="0"/>
            <Button x:Name="btn_new_input"
                    Content="+ 日報入力"
                    Style="{StaticResource style_button_primary}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="btn_new_input_Click"/>
        </Grid>

        <!-- ===== フィルター行 ===== -->
        <Border Grid.Row="1"
                Style="{StaticResource style_card}"
                Padding="15,12"
                Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="月度："
                           VerticalAlignment="Center"
                           Foreground="{StaticResource brush_text_primary}"
                           FontSize="13"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="cmb_month"
                          Width="160"
                          VerticalAlignment="Center"
                          SelectionChanged="cmb_month_SelectionChanged"/>
                <TextBlock Text="氏名："
                           VerticalAlignment="Center"
                           Foreground="{StaticResource brush_text_primary}"
                           FontSize="13"
                           Margin="20,0,8,0"/>
                <ComboBox x:Name="cmb_employee"
                          Width="120"
                          VerticalAlignment="Center"
                          SelectionChanged="cmb_employee_SelectionChanged"/>
                <TextBlock x:Name="txt_record_count"
                           Text="件数：0件"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource brush_text_secondary}"
                           FontSize="12"
                           Margin="30,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== DataGrid（22列・案_日報レイアウト） ===== -->
        <Border Grid.Row="2" Style="{StaticResource style_card}" Padding="0">
            <DataGrid x:Name="grid_reports"
                      Style="{StaticResource style_datagrid}"
                      ItemsSource="{Binding}"
                      MouseDoubleClick="grid_reports_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日付"
                                        Binding="{Binding report_date_display}"
                                        Width="60"/>
                    <DataGridTextColumn Header="氏名"
                                        Binding="{Binding employee_name}"
                                        Width="80"/>
                    <DataGridTextColumn Header="出勤"
                                        Binding="{Binding clock_in_display}"
                                        Width="55"/>
                    <DataGridTextColumn Header="退勤"
                                        Binding="{Binding clock_out_display}"
                                        Width="55"/>
                    <DataGridTextColumn Header="早朝"
                                        Binding="{Binding early_morning_display}"
                                        Width="50"/>
                    <DataGridTextColumn Header="残業"
                                        Binding="{Binding overtime_display}"
                                        Width="50"/>
                    <DataGridTextColumn Header="深夜"
                                        Binding="{Binding late_night_display}"
                                        Width="50"/>
                    <DataGridTextColumn Header="開始"
                                        Binding="{Binding start_location_display}"
                                        Width="65"/>
                    <DataGridTextColumn Header="終了"
                                        Binding="{Binding end_location_display}"
                                        Width="65"/>
                    <DataGridTextColumn Header="職種"
                                        Binding="{Binding job_type}"
                                        Width="50"/>
                    <DataGridTextColumn Header="区分"
                                        Binding="{Binding category_code}"
                                        Width="60"/>
                    <DataGridTextColumn Header="業務名"
                                        Binding="{Binding project_name}"
                                        Width="100"/>
                    <DataGridTextColumn Header="詳細"
                                        Binding="{Binding detail}"
                                        Width="220"/>
                    <DataGridTextColumn Header="時間(h)"
                                        Binding="{Binding hours}"
                                        Width="55"/>
                    <DataGridTextColumn Header="ソフト・機材"
                                        Binding="{Binding software}"
                                        Width="110"/>
                    <DataGridTextColumn Header="料金"
                                        Binding="{Binding software_cost_display}"
                                        Width="60"/>
                    <DataGridTextColumn Header="車両"
                                        Binding="{Binding vehicle}"
                                        Width="100"/>
                    <DataGridTextColumn Header="発"
                                        Binding="{Binding from_location}"
                                        Width="80"/>
                    <DataGridTextColumn Header="着"
                                        Binding="{Binding to_location}"
                                        Width="100"/>
                    <DataGridTextColumn Header="距離"
                                        Binding="{Binding distance_display}"
                                        Width="55"/>
                    <DataGridTextColumn Header="移動方法"
                                        Binding="{Binding transport}"
                                        Width="70"/>
                    <DataGridTextColumn Header="備考"
                                        Binding="{Binding note}"
                                        Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
