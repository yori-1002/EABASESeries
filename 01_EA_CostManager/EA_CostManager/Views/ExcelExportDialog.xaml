<Window x:Class="EA_CostManager.Views.ExcelExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel書き出し"
        Width="1200" Height="720"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,6,10,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox" x:Key="col_check">
            <Setter Property="Margin" Value="0,3,12,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="300"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左パネル：設定 -->
        <Border Grid.Column="0" Background="#F7FAFD"
                BorderBrush="#CCDDEE" BorderThickness="0,0,1,0">
            <DockPanel Margin="14">

                <!-- 下部ボタン -->
                <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="txt_info" FontSize="11"
                                   Foreground="#555" TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btn_cancel" Content="キャンセル"
                                    Width="90" Height="32" Margin="0,0,8,0"
                                    Click="btn_cancel_Click"/>
                            <Button x:Name="btn_export" Content="📊 Excel書き出し"
                                    Width="130" Height="32"
                                    Background="#1D6F42" Foreground="White"
                                    Click="btn_export_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- 書き出し対象 -->
                        <GroupBox Header="書き出し対象">
                            <StackPanel>
                                <RadioButton x:Name="rb_all_tab" Content="全件タブ"
                                             IsChecked="True" FontSize="12" FontWeight="Normal"
                                             Margin="0,4,0,4" Checked="option_Changed"/>
                                <RadioButton x:Name="rb_filter_select"
                                             Content="絞り込みタブを選択"
                                             FontSize="12" FontWeight="Normal"
                                             Margin="0,4,0,4" Checked="option_Changed"/>
                                <Border x:Name="border_tab_list"
                                        Margin="16,2,0,2" Visibility="Collapsed">
                                    <ListBox x:Name="list_filter_tabs" MaxHeight="120"
                                             BorderThickness="1" BorderBrush="#CCDDEE"
                                             CheckBox.Checked="option_Changed"
                                             CheckBox.Unchecked="option_Changed">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding tab_name}"
                                                          IsChecked="{Binding is_checked, Mode=TwoWay}"
                                                          Margin="2,3" FontSize="11" FontWeight="Normal"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="2"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                                <RadioButton x:Name="rb_all"
                                             Content="すべて（全件＋絞り込みタブ）"
                                             FontSize="12" FontWeight="Normal"
                                             Margin="0,4,0,4" Checked="option_Changed"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 期間指定 -->
                        <GroupBox Header="期間指定（任意）">
                            <StackPanel>
                                <CheckBox x:Name="chk_period" Content="期間を指定する"
                                          FontSize="12" FontWeight="Normal" Margin="0,4,0,4"
                                          Checked="option_Changed" Unchecked="option_Changed"/>
                                <Grid x:Name="grid_period" Margin="16,4,0,0"
                                      Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="開始日"
                                               VerticalAlignment="Center" FontSize="12" FontWeight="Normal"/>
                                    <DatePicker x:Name="dp_from" Grid.Row="0" Grid.Column="1"
                                                FontSize="12" SelectedDateChanged="option_Changed"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="終了日"
                                               VerticalAlignment="Center" FontSize="12" FontWeight="Normal"/>
                                    <DatePicker x:Name="dp_to" Grid.Row="2" Grid.Column="1"
                                                FontSize="12" SelectedDateChanged="option_Changed"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 列選択 -->
                        <GroupBox Header="出力列の選択">
                            <StackPanel>
                                <TextBlock Text="固定列：作業日・作業内容（常に出力）"
                                           FontSize="10" Foreground="#888"
                                           FontWeight="Normal" Margin="0,0,0,6"/>
                                <TextBlock Text="■ 技師" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#2E75B6" Margin="0,2,0,2"/>
                                <WrapPanel Margin="8,0,0,0">
                                    <CheckBox x:Name="chk_eng_name"   Content="技師氏名"    Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_eng_count"  Content="人数"        Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_eng_day"    Content="人工(日)"    Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_eng_hour"   Content="時間(h)"     Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_eng_cost"   Content="人件費"      Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                </WrapPanel>
                                <TextBlock Text="■ 助手" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#2E75B6" Margin="0,4,0,2"/>
                                <WrapPanel Margin="8,0,0,0">
                                    <CheckBox x:Name="chk_ast_name"   Content="助手氏名"    Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_ast_count"  Content="人数"        Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_ast_day"    Content="人工(日)"    Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_ast_hour"   Content="時間(h)"     Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_ast_cost"   Content="人件費"      Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                </WrapPanel>
                                <TextBlock Text="■ 集計" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#2E75B6" Margin="0,4,0,2"/>
                                <WrapPanel Margin="8,0,0,0">
                                    <CheckBox x:Name="chk_total_man"  Content="合計人工(日)" Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_person"     Content="人件費合計"  Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                </WrapPanel>
                                <TextBlock Text="■ 交通費・損料" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#2E75B6" Margin="0,4,0,2"/>
                                <WrapPanel Margin="8,0,0,0">
                                    <CheckBox x:Name="chk_dist"       Content="距離(km往復)" Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_vehicle"    Content="台数"         Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_trans"      Content="交通費"       Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_use_count"  Content="使用数"       Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_equip"      Content="損料"         Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                    <CheckBox x:Name="chk_equip_name" Content="機材・使用者" Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                </WrapPanel>
                                <TextBlock Text="■ 合計" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#2E75B6" Margin="0,4,0,2"/>
                                <WrapPanel Margin="8,0,0,0">
                                    <CheckBox x:Name="chk_total"      Content="合計金額"    Style="{StaticResource col_check}" IsChecked="True" Checked="option_Changed" Unchecked="option_Changed"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- ★v0.9.7追加：ヘッダー情報の表示オプション -->
                        <!-- お客様向けはOFF、社内用ならONにすると条件・カスタム単価が記載される -->
                        <GroupBox Header="ヘッダー情報（任意）">
                            <StackPanel>
                                <TextBlock Text="出力ファイルの先頭に記載する情報を選択できます。"
                                           FontSize="10" Foreground="#666"
                                           Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <CheckBox x:Name="chk_show_filter_info"
                                          Content="絞り込み条件を表示する（月度・キーワード・氏名・期間）"
                                          FontSize="11"
                                          Margin="0,2,0,2"
                                          Checked="option_Changed" Unchecked="option_Changed"/>
                                <CheckBox x:Name="chk_show_custom_rate"
                                          Content="カスタム単価が適用されている旨を表示する"
                                          FontSize="11"
                                          Margin="0,2,0,2"
                                          Checked="option_Changed" Unchecked="option_Changed"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 出力先 -->
                        <GroupBox Header="出力先フォルダ">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txt_output_dir" Grid.Column="0"
                                         FontSize="11" Padding="6,5" Margin="0,0,8,0"
                                         IsReadOnly="True" Background="#F5F5F5"/>
                                <Button Grid.Column="1" Content="参照..."
                                        Height="28" Click="btn_browse_Click" FontSize="11"/>
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 区切り -->
        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch"
                      Background="#CCDDEE" Cursor="SizeWE"/>

        <!-- 右パネル：DataGridプレビュー -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1D6F42" Padding="12,6">
                <TextBlock Text="書き出しプレビュー（設定変更で自動更新）"
                           Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <DataGrid x:Name="preview_grid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#CCDDEE"
                      VerticalGridLinesBrush="#CCDDEE"
                      FontSize="11"
                      RowHeight="22"
                      AlternatingRowBackground="#F7FAFD"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2E75B6"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
