<UserControl x:Class="EA_CostManager.Views.WorkloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EA_CostManager.Converters">

    <!-- ▼ 修正 [Sprint 9A]：工数表ページ
         【7B からの変更点】
         ・案件選択の ComboBox を廃止し、原価集計と同じ「現場タブ」方式に変更。
           タブは WrapPanel で折り返し、3段（MaxHeight=90）を超える分はスクロール。
           ▼/▲ ボタンで全展開／折りたたみを切り替える（CostPage と同一構造）。
         ・現場情報バーを追加（区分コード／現場名／会社名／詳細）。
           詳細は DockPanel の最後の子として残り幅を占有させ、長文でも他要素を
           侵食しないよう省略記号（TextTrimming）を有効にしている。
         ・大区分（会社）はサイドバー（MainWindow）側で選択する。
         【非搭載（意図的）】
         ・右クリックメニュー（属性変更・編集・アーカイブ）と複数選択は載せない。
           工数表は閲覧専用であり、現場の編集は原価集計側で行うため。 -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVis" />
        <conv:StringToColorBrushConverter x:Key="ColorBrush" />

        <!-- 数値列（右寄せ）の共通スタイル -->
        <Style x:Key="cell_right" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== ヘッダーバー ===== -->
        <Border Grid.Row="0" Background="{DynamicResource brush_accent}" Padding="16,10">
            <DockPanel>
                <!-- 操作ボタンは Right を先に宣言して右端に固定する -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- ▼ 修正 [Sprint 7C-1]：「標準区分セット作成」を廃止し「分類設定」に置き換え。
                         業務区分は案件ごとに大きく異なるため、固定の標準セットを配るのではなく、
                         案件ごとに区分・キーワードを作る（他案件からのコピーも可能）方式にした。 -->
                    <!-- ▼ 追加 [Sprint 7D-1]：サブ分類グループの一括開閉
                         グループ表示中のタブ（サブ分類が適用されている区分）でのみ表示する。
                         押すたびに「すべて展開」と「すべて折りたたむ」が切り替わる。 -->
                    <Button Content="{Binding expand_toggle_text}"
                            Command="{Binding toggle_expand_command}"
                            Visibility="{Binding can_toggle_expand, Converter={StaticResource BoolToVis}}"
                            Padding="12,5" Margin="0,0,8,0" FontSize="12"
                            Background="White" Foreground="#0F5FA8" BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="サブ分類ごとのグループをまとめて開閉いたします。" />
                    <Button Content="⚙ 分類設定"
                            Command="{Binding open_classify_command}"
                            Padding="12,5" Margin="0,0,8,0" FontSize="12"
                            Background="White" Foreground="#0F5FA8" BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="業務区分・キーワード・サブ分類を編集いたします。" />
                    <Button Content="🔄 更新"
                            Command="{Binding reload_command}"
                            Padding="12,5" FontSize="12"
                            Background="White" Foreground="#0F5FA8" BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="案件一覧と集計を最新の状態に更新いたします。" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Left"
                           Text="工数表"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ===== ステータスバー ===== -->
        <Border Grid.Row="1" Background="#F0F4F8" Padding="16,5"
                BorderThickness="0,0,0,1" BorderBrush="#DDEEFF">
            <TextBlock Text="{Binding status_message}"
                       FontSize="12" Foreground="#444" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- ===== メインコンテンツ ===== -->
        <Grid Grid.Row="2">

            <!-- ===== 現場タブ（大区分フィルタ済み）===== -->
            <!-- ▼ 修正 [9A-fix1]：Background を透明にする
                 既定の背景色のままだと、タブが0件のときに白い矩形が全面に描画され、
                 下（背面）にある案内カードを覆い隠してしまうため。 -->
            <TabControl x:Name="project_tab_control"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding filtered_projects}"
                        SelectedItem="{Binding selected_project}"
                        IsSynchronizedWithCurrentItem="False">

                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- タブヘッダーエリア：3段制限(MaxHeight=90) + スクロール + 展開ボタン -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer Grid.Column="0"
                                              x:Name="tab_header_scroll"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="90">
                                    <!-- Grid.IsSharedSizeScope：全タブ幅を最長タブ幅に統一 -->
                                    <WrapPanel x:Name="HeaderPanel"
                                               IsItemsHost="True"
                                               KeyboardNavigation.TabIndex="1"
                                               Background="Transparent"
                                               Orientation="Horizontal"
                                               Grid.IsSharedSizeScope="True" />
                                </ScrollViewer>
                                <!-- ▼/▲ 展開ボタン（コードビハインドの tab_expand_border_click で処理） -->
                                <Border Grid.Column="1"
                                        x:Name="tab_expand_border"
                                        Background="{DynamicResource brush_accent}"
                                        Cursor="Hand"
                                        ToolTip="タブ一覧を展開 / 折りたたむ">
                                    <TextBlock x:Name="tab_expand_icon"
                                               Text="▼"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,4" />
                                </Border>
                            </Grid>

                            <!-- タブコンテンツ部分 -->
                            <Border Grid.Row="1"
                                    x:Name="ContentPanel"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    KeyboardNavigation.TabNavigation="Local"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- タブヘッダー：色帯＋タブ名（原価集計と同じ見た目） -->
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="WorkloadTabHeaderWidth" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="2,2,2,0">
                                <Rectangle Width="{DynamicResource tab_color_bar_width}"
                                           Height="14" RadiusX="2" RadiusY="2"
                                           Fill="{Binding tab_color, Converter={StaticResource ColorBrush}}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding tab_name}"
                                           VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <!-- タブコンテンツ：現場情報バー ＋ 業務区分タブ -->
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- ===== 現場情報バー =====
                                 詳細（detail）は DockPanel の最後の子（LastChildFill）として
                                 残り幅を占有させている。StackPanel 内では幅が確定せず
                                 （無限幅が与えられる）、長文が他要素を侵食するため。
                                 幅が確定することで TextTrimming（省略記号）が機能する。 -->
                            <Border Grid.Row="0" Background="#EEF4FB" Padding="10,6"
                                    BorderThickness="0,0,0,1" BorderBrush="#CCDDF0">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               FontWeight="Bold" FontSize="13" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding category_code}" />
                                    <TextBlock DockPanel.Dock="Left"
                                               FontSize="13" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding site_name}" />
                                    <TextBlock DockPanel.Dock="Left"
                                               FontSize="12" Foreground="#666" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding company_name}" />
                                    <!-- 詳細：残り幅を占有し、収まらない場合は省略記号を表示 -->
                                    <TextBlock FontSize="12" Foreground="#444"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding detail}"
                                               Text="{Binding detail, Mode=OneWay, StringFormat='詳細：{0}'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding detail, Mode=OneWay}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding detail, Mode=OneWay}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <!-- ===== 業務区分タブ（全体／区分ごと／未分類） =====
                                 このDataTemplate内のDataContextは現場タブ（workload_project_item）のため、
                                 ページVMの tabs / selected_tab は RelativeSource で参照する。 -->
                            <TabControl Grid.Row="1"
                                        Background="Transparent" BorderThickness="0"
                                        Margin="8,8,8,0"
                                        ItemsSource="{Binding DataContext.tabs,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SelectedItem="{Binding DataContext.selected_tab,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding name}" FontSize="12" Padding="6,2" />
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <!-- ▼ 修正 [9A-fix3]：集計表（上段）＋明細一覧（下段）の2段組にする。
                                             区分タブでは両方を表示し、サブ分類が未登録でも業務内容の明細が見える。
                                             ・[全体]   … 集計表のみ（明細行を持たないため下段は消える）
                                             ・[区分]   … 集計表（サブ分類がある場合のみ）＋ 明細一覧
                                             ・[未分類] … 明細一覧のみ
                                             上段は MaxHeight を設けて、明細の表示領域を潰さないようにする。 -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <!-- ▼ 追加 [7C-fix2]：明細一覧の合計バー -->
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 上段：集計表（区分別 or サブ分類別） -->
                                            <DataGrid Grid.Row="0"
                                                      ItemsSource="{Binding summary_rows}"
                                                      Visibility="{Binding show_summary, Converter={StaticResource BoolToVis}}"
                                                      MaxHeight="320"
                                                      VerticalScrollBarVisibility="Auto"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="All"
                                                      HorizontalGridLinesBrush="#E5EDF5"
                                                      VerticalGridLinesBrush="#E5EDF5"
                                                      RowHeaderWidth="0"
                                                      FontSize="12">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <!-- 合計行は太字＋薄背景で強調 -->
                                                            <DataTrigger Binding="{Binding is_total}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="Background" Value="#EEF3F9" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="分類" Binding="{Binding name}" Width="*" />
                                                    <DataGridTextColumn Header="原価（円）" Binding="{Binding cost_display}"
                                                                        Width="130" ElementStyle="{StaticResource cell_right}" />
                                                    <DataGridTextColumn Header="延べ人数(技師)" Binding="{Binding engineer_display}"
                                                                        Width="115" ElementStyle="{StaticResource cell_right}" />
                                                    <DataGridTextColumn Header="延べ人数(助手)" Binding="{Binding assistant_display}"
                                                                        Width="115" ElementStyle="{StaticResource cell_right}" />
                                                    <DataGridTextColumn Header="延べ(不明)" Binding="{Binding unknown_display}"
                                                                        Width="90" ElementStyle="{StaticResource cell_right}" />
                                                    <DataGridTextColumn Header="件数" Binding="{Binding row_count}"
                                                                        Width="70" ElementStyle="{StaticResource cell_right}" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- 下段：明細一覧（区分タブ・未分類タブ共通）
                                                 ここに出る業務内容を見て、サブ分類のキーワード（橋名等）や
                                                 未登録のキーワードを拾う運用を想定している。 -->
                                            <!-- ▼ 修正 [7C-fix5]：明細をサブ分類ごとにグループ表示する。
                                                 grouped_detail（CollectionViewSource）を経由することで、
                                                 subgroup_name ごとに見出し付きで区切られる。
                                                 サブ分類が未登録の区分・未分類タブでは subgroup_name が空のため、
                                                 見出しは1つも作られず、従来どおりの一覧表示になる。 -->
                                            <DataGrid Grid.Row="1"
                                                      ItemsSource="{Binding grouped_detail.View}"
                                                      SelectedItem="{Binding DataContext.selected_detail_row,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Visibility="{Binding has_detail, Converter={StaticResource BoolToVis}}"
                                                      Margin="0,8,0,0"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="All"
                                                      HorizontalGridLinesBrush="#E5EDF5"
                                                      VerticalGridLinesBrush="#E5EDF5"
                                                      RowHeaderWidth="0"
                                                      FontSize="12">
                                                <!-- ▼ 追加 [7C-fix5]：サブ分類ごとのグループ見出し。
                                                     見出しの文字列（小計込み）は ViewModel 側で組み立て済みのため、
                                                     ここでは表示するだけでよい（XAML側での再集計は行わない）。 -->
                                                <!-- ▼ 修正 [Sprint 9D-2]：サブ分類グループを折り畳み・展開できるようにする。
                                                     ContainerStyle で Expander を使い、見出しクリックで開閉する。
                                                     IsExpanded のバインド先は「このタブ（workload_tab_item）の all_expanded」。
                                                     AncestorType=DataGrid で辿るのは、この DataGrid の DataContext が
                                                     タブ自身（workload_tab_item）だから。
                                                     ※ 旧実装は UserControl（＝ページVM）の all_expanded を見ていたため、
                                                       値が全タブで共有され、ある区分タブで折りたたむと他の区分タブまで
                                                       折りたたまれたままになっていた。タブ自身の値を見ることで、
                                                       「すべて折りたたむ」は今見ているタブにだけ効く。
                                                     （Mode=OneWay にしておくことで、個別に開閉してもタブ側の値は変わらず、
                                                       ボタンを押した時だけそのタブの全グループが一括で切り替わる） -->
                                                <DataGrid.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.ContainerStyle>
                                                            <Style TargetType="GroupItem">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="GroupItem">
                                                                            <Expander Margin="0,4,0,0"
                                                                                      Background="#D6E4F0"
                                                                                      BorderBrush="#8FAECB"
                                                                                      BorderThickness="0,0,0,1"
                                                                                      IsExpanded="{Binding DataContext.all_expanded,
                                                                                                   RelativeSource={RelativeSource AncestorType=DataGrid},
                                                                                                   Mode=OneWay, FallbackValue=True}">
                                                                                <Expander.Header>
                                                                                    <!-- Name にはVMで組み立てた小計込みの見出し文字列が入る -->
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               FontSize="12" FontWeight="Bold" Foreground="#123"
                                                                                               Margin="2,3,0,3" />
                                                                                </Expander.Header>
                                                                                <!-- 展開時に、そのグループの明細行を表示する -->
                                                                                <ItemsPresenter />
                                                                            </Expander>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </GroupStyle.ContainerStyle>
                                                    </GroupStyle>
                                                </DataGrid.GroupStyle>

                                                <!-- ▼ 追加 [Sprint 7C-1]：明細行からキーワードを登録する導線
                                                     未分類・各区分タブのどちらからでも、業務内容を見ながら
                                                     その場でキーワードを登録できるようにする。 -->
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="この業務内容からキーワードを登録..."
                                                                  Command="{Binding PlacementTarget.DataContext.add_keyword_from_detail_command,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="🏷" FontSize="11" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="日付" Binding="{Binding record_date}" Width="100" />
                                                    <DataGridTextColumn Header="作業者" Binding="{Binding employee_name}" Width="110" />
                                                    <DataGridTextColumn Header="職種" Binding="{Binding job_type}" Width="70" />
                                                    <DataGridTextColumn Header="業務内容" Binding="{Binding task}" Width="*" />
                                                    <DataGridTextColumn Header="時間" Binding="{Binding hours_display}"
                                                                        Width="70" ElementStyle="{StaticResource cell_right}" />
                                                    <DataGridTextColumn Header="人日" Binding="{Binding days_display}"
                                                                        Width="80" ElementStyle="{StaticResource cell_right}" />
                                                    <DataGridTextColumn Header="原価（円）" Binding="{Binding cost_display}"
                                                                        Width="110" ElementStyle="{StaticResource cell_right}" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- ▼ 修正 [7C-fix3]：明細一覧の合計バー（見やすさを重視した形に変更）
                                                 旧実装は数字だけが右端に並んでおり、何の値か分からなかった。
                                                 「時間 / 人日 / 原価」のラベルを数字に添え、上端に太い罫線を引いて
                                                 明細との区切りを明確にする。DataGrid の列幅は利用者が変更できるため、
                                                 列位置に合わせるのではなく、ラベル付きでまとめて右寄せする。 -->
                                            <Border Grid.Row="2"
                                                    Visibility="{Binding has_detail, Converter={StaticResource BoolToVis}}"
                                                    Background="#E3ECF6" BorderBrush="#8FAECB" BorderThickness="0,2,0,0"
                                                    Padding="12,8">
                                                <DockPanel LastChildFill="False">

                                                    <!-- 左：合計であることと件数 -->
                                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                                               FontSize="13" FontWeight="Bold" Foreground="#123">
                                                        <Run Text="合　計" />
                                                        <Run Text="　" /><Run Text="{Binding detail_count, Mode=OneWay}" /><Run Text=" 件" />
                                                    </TextBlock>

                                                    <!-- 右：原価 → 人日 → 時間 の順に右端から積む（表示は 時間・人日・原価 の並び） -->
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="24,0,0,0">
                                                        <TextBlock Text="原価" FontSize="12" Foreground="#456"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding detail_total_cost}"
                                                                   FontSize="15" FontWeight="Bold" Foreground="#0F5FA8"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="円" FontSize="12" Foreground="#456"
                                                                   VerticalAlignment="Center" Margin="3,0,0,0" />
                                                    </StackPanel>

                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="24,0,0,0">
                                                        <TextBlock Text="人日" FontSize="12" Foreground="#456"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding detail_total_days}"
                                                                   FontSize="15" FontWeight="Bold" Foreground="#123"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="24,0,0,0">
                                                        <TextBlock Text="時間" FontSize="12" Foreground="#456"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding detail_total_hours}"
                                                                   FontSize="15" FontWeight="Bold" Foreground="#123"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="h" FontSize="12" Foreground="#456"
                                                                   VerticalAlignment="Center" Margin="3,0,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- ▼ 修正 [9A-fix1]：対象案件が1件も無い場合の案内
                 TabControl より後に宣言することで手前に描画させる。
                 （先に書くと、空の TabControl の背景に覆われて見えなくなるため） -->
            <Border Background="White" Margin="24" Padding="24"
                    CornerRadius="8" BorderBrush="#DDEEFF" BorderThickness="1"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Visibility="{Binding has_no_projects, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="工数表の対象となる案件がございません。"
                               FontSize="14" FontWeight="Bold" Foreground="#333"
                               Margin="0,0,0,10" />
                    <TextBlock FontSize="12" Foreground="#666" TextWrapping="Wrap">
                        工数表は「業務単位集計」に設定された案件のみが対象となります。<LineBreak /><LineBreak />
                        原価集計画面で対象の現場タブを開き、集計モードの「変更▾」から<LineBreak />
                        「業務単位集計（担当者別）」→「このタブに適用」を実行してください。<LineBreak /><LineBreak />
                        設定後、この画面の「更新」ボタンを押してください。
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 集計中オーバーレイ（操作をブロックする） -->
            <Border Background="#88FFFFFF"
                    Visibility="{Binding is_loading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="集計しております..." FontSize="15" FontWeight="SemiBold"
                           Foreground="#333"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
