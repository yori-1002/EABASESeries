<Window x:Class="EA_CostManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EA_CostManager.ViewModels"
        xmlns:views="clr-namespace:EA_CostManager.Views"
        xmlns:conv="clr-namespace:EA_CostManager.Converters"
        Title="EA_CostManager" Width="1948" Height="1286"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource brush_bg_main}">

    <Window.DataContext>
        <vm:main_view_model />
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="bool_to_vis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="83" />
            <ColumnDefinition Width="137"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== サイドバー ===== -->
        <!-- ▼▼▼ 修正：StaticResource → DynamicResource（テーマ即時反映対応）▼▼▼ -->
        <Border Grid.Column="0" Background="{DynamicResource brush_primary}" Grid.ColumnSpan="2">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,24,20,20"
                        BorderBrush="#2D4470" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="CostManager"
                                   FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="EABASE Series"
                                   FontSize="11" Foreground="#7F8FA6" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- ▼▼▼ 修正：StackPanel → ScrollViewer に変更（グループが多い場合にスクロール可能） ▼▼▼ -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="メニュー" FontSize="10" Foreground="#C8D8E8"
                                   Margin="20,12,0,6" FontWeight="SemiBold" />

                        <Button Content="  ダッシュボード"
                                Command="{Binding navigate_to_dashboard_command}"
                                Style="{StaticResource style_sidebar_button}" />

                        <!-- 原価集計ボタン -->
                        <Button Content="  原価集計"
                                Command="{Binding navigate_to_cost_command}"
                                Style="{StaticResource style_sidebar_button}" />

                        <!-- ▼▼▼ 追加：原価集計クリックで大区分ツリーを展開 ▼▼▼
                             is_cost_expanded が true のときのみ表示
                             各グループをクリックすると group_item_Click が発火して
                             cost_vm.selected_group が変更され filtered_tabs が更新される -->
                        <ItemsControl ItemsSource="{Binding cost_vm.group_items}"
                                      Visibility="{Binding is_cost_expanded, Converter={StaticResource bool_to_vis}}"
                                      Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="28,7,12,7"
                                            Cursor="Hand"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Click="group_item_Click"
                                            Tag="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize"   Value="12"/>
                                                <Style.Triggers>
                                                    <!-- ▼▼▼ 追加：選択中グループをハイライト（Sprint 3.7） ▼▼▼ -->
                                                    <!-- is_selected=true のとき明るい青背景＋左端にアクセントボーダー -->
                                                    <DataTrigger Binding="{Binding is_selected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource brush_nav_selected}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource brush_primary_light}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding display_label}"
                                                   TextWrapping="Wrap" FontSize="12"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="データ" FontSize="10" Foreground="#C8D8E8"
                                   Margin="20,20,0,6" FontWeight="SemiBold" />

                        <Button Content="  日報取込"
                                Command="{Binding navigate_to_import_command}"
                                Style="{StaticResource style_sidebar_button}" />

                        <TextBlock Text="システム" FontSize="10" Foreground="#C8D8E8"
                                   Margin="20,20,0,6" FontWeight="SemiBold" />

                        <Button Content="  設定"
                                Command="{Binding navigate_to_settings_command}"
                                Style="{StaticResource style_sidebar_button}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- バージョン表示 -->
                <!-- ▼ v1.0.0 修正：固定文字列「v0.7.0 - Beta」から動的取得に変更 -->
                <!--   コードビハインドの app_version_display プロパティで AssemblyVersion から自動取得 -->
                <!--   csproj の <Version> を上げるだけで自動連動するため、表示更新忘れを防止 -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding app_version_display, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="10" Foreground="#C8D8E8"
                           Margin="20,0,0,16" VerticalAlignment="Bottom" />
            </DockPanel>
        </Border>

        <!-- ===== メインコンテンツ ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <!-- ヘッダーバー（ユーザーアイコン表示） -->
                <RowDefinition Height="36"/>
                <!-- ▼▼▼ [Sprint 6] アップデート通知バナー（通常は非表示・show_update_bannerで表示） ▼▼▼ -->
                <RowDefinition x:Name="row_update_banner" Height="0"/>
                <!-- コンテンツ本体 -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ▼▼▼ 追加：ヘッダーバー（右上ユーザーアイコン）▼▼▼ -->
            <Border Grid.Row="0"
                    Background="{StaticResource brush_bg_main}"
                    BorderBrush="#DDE6F0" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0">
                    <!-- 右端：ログイン中ユーザーアイコン＋バッジ -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                        <!-- ホバーでオンラインユーザー名一覧をツールチップ表示 -->
                        <ToolTipService.ToolTip>
                            <!-- ▼▼▼ 修正：ToolTipはPopupとして別ビジュアルツリーで動作するため ▼▼▼ -->
                            <!-- RelativeSource AncestorType=Window は届かない              -->
                            <!-- PlacementTarget.DataContext で親要素のVMを引き継いで解決する -->
                            <ToolTip DataContext="{Binding PlacementTarget.DataContext,
                                                           RelativeSource={RelativeSource Self}}">
                                <StackPanel MinWidth="100">
                                    <TextBlock Text="ログイン中のユーザー"
                                               FontSize="11" FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>
                                    <!-- ▼▼▼ [現場タブ追跡] display_text で「ユーザー：現場名」表示 ▼▼▼ -->
                                    <ItemsControl ItemsSource="{Binding online_users}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding display_text}"
                                                           FontSize="12" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                        <!-- アイコン -->
                        <TextBlock Text="👤" FontSize="15" VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <!-- 人数バッジ -->
                        <!-- ▼▼▼ 修正：StaticResource → DynamicResource（テーマ即時反映対応）▼▼▼ -->
                        <Border Background="{DynamicResource brush_accent}"
                                CornerRadius="9" MinWidth="18" Height="18"
                                Padding="5,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.online_user_count,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>


            <!-- ▼▼▼ [Sprint 6] アップデート通知バナー ▼▼▼ -->
            <Border x:Name="border_update_banner"
                    Grid.Row="1"
                    Background="#E67E22"
                    Visibility="Collapsed">
                <DockPanel Margin="16,6">
                    <Button DockPanel.Dock="Right"
                            x:Name="btn_update_now"
                            Content="今すぐ更新"
                            Background="White"
                            Foreground="#E67E22"
                            FontWeight="Bold"
                            FontSize="12"
                            Padding="14,4"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btn_update_now_Click"/>
                    <Button DockPanel.Dock="Right"
                            Content="後で"
                            Background="Transparent"
                            Foreground="White"
                            FontSize="12"
                            Padding="10,4"
                            BorderThickness="0"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Click="btn_update_later_Click"/>
                    <TextBlock x:Name="txt_update_message"
                               Text="🎉 新しいバージョンが利用できます"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <!-- コンテンツページ群（Grid.Row="2"） -->
            <Grid Grid.Row="2">

                <views:DashboardPage
                Visibility="{Binding DataContext.is_dashboard,
                             RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource bool_to_vis}}"/>

                <views:ImportPage
                Visibility="{Binding DataContext.is_import,
                             RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource bool_to_vis}}"/>

                <views:CostPage
                Visibility="{Binding DataContext.is_cost,
                             RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource bool_to_vis}}"/>

                <views:SettingsPage
                Visibility="{Binding DataContext.is_settings,
                             RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource bool_to_vis}}" Loaded="SettingsPage_Loaded"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
