            <!-- セパレーター -->
            <Rectangle Grid.Column="1" Width="1" Fill="#CCDDF0"/>

            <!-- ===== 右コンテンツエリア ===== -->
            <Grid Grid.Column="2">

                <!-- ▼▼▼ [Sprint 5D] エラーログ参照セクション ▼▼▼ -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding current_content}" Value="{x:Null}"/>
                                        <Condition Binding="{Binding is_error_log_page}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
