<UserControl x:Class="EA_CostManager.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EA_CostManager.Converters"
             xmlns:vm="clr-namespace:EA_CostManager.ViewModels">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <!-- int値とパラメータが一致するかをboolで返すConverter（RadioButton用） -->
        <conv:IntEqualConverter x:Key="IntEqual"/>
        <!-- string値とパラメータが一致するかをboolで返すConverter（RadioButton用） -->
        <conv:StringEqualConverter x:Key="StrEqual"/>

        <!-- ===== 共通スタイル ===== -->

        <!-- セクション見出し -->
        <Style x:Key="section_header" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource brush_accent}"/>
            <Setter Property="Margin"     Value="0,0,0,12"/>
        </Style>

        <!-- ステータスラベル -->
        <Style x:Key="status_label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin"   Value="0,8,0,0"/>
        </Style>

        <!-- アクションボタン（青） -->
        <Style x:Key="btn_primary" TargetType="Button">
            <Setter Property="Background"  Value="{DynamicResource brush_accent}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="14,6"/>
            <Setter Property="Margin"      Value="0,0,8,0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- アクションボタン（緑・保存系） -->
        <Style x:Key="btn_success" TargetType="Button">
            <Setter Property="Background"  Value="#27AE60"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Padding"     Value="14,6"/>
            <Setter Property="Margin"      Value="0,0,8,0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- アクションボタン（赤・削除系） -->
        <Style x:Key="btn_danger" TargetType="Button">
            <Setter Property="Background"  Value="#C0392B"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="10,4"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- アクションボタン（オレンジ・復元系） -->
        <Style x:Key="btn_warn" TargetType="Button">
            <Setter Property="Background"  Value="#E67E22"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="10,4"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- DataGrid 共通 -->
        <Style x:Key="master_grid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"       Value="False"/>
            <Setter Property="CanUserAddRows"            Value="False"/>
            <Setter Property="CanUserDeleteRows"         Value="False"/>
            <Setter Property="CanUserReorderColumns"     Value="False"/>
            <Setter Property="SelectionMode"             Value="Single"/>
            <Setter Property="GridLinesVisibility"       Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"  Value="#DDDDDD"/>
            <Setter Property="HeadersVisibility"         Value="Column"/>
            <Setter Property="RowHeight"                 Value="32"/>
            <Setter Property="FontSize"                  Value="12"/>
            <Setter Property="BorderThickness"           Value="1"/>
            <Setter Property="BorderBrush"               Value="#CCCCCC"/>
        </Style>

        <!-- ===== 右コンテンツ DataTemplate ===== -->

        <!-- 人員マスタ -->
        <DataTemplate DataType="{x:Type vm:master_employees_view_model}">
            <Grid Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="人員マスタ" Style="{StaticResource section_header}"/>

                <!-- ツールバー -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="＋ 追加" Command="{Binding add_command}"
                            Style="{StaticResource btn_primary}"/>
                    <Button Content="💾 保存" Command="{Binding save_command}"
                            Style="{StaticResource btn_success}"/>
                    <Button Content="↺ デフォルトに戻す" Command="{Binding reset_to_default_command}"
                            Background="#5D6D7E" Foreground="White" FontSize="12"
                            Padding="14,6" Cursor="Hand" BorderThickness="0"/>
                </StackPanel>

                <!-- 一覧グリッド -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding employees}"
                          SelectedItem="{Binding selected_row}"
                          Style="{StaticResource master_grid}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding job_type}" Value="技師">
                                    <Setter Property="Background" Value="#DDEEFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="氏名" Binding="{Binding employee_name, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                        <DataGridTemplateColumn Header="職種" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding job_type}" VerticalAlignment="Center" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding job_type, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.job_type_options}"
                                              IsEditable="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="日額単価(円)" Binding="{Binding daily_rate, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                        <!-- 残りのスペースを埋めるダミーカラム -->
                        <DataGridTextColumn Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3" Text="{Binding status}" Style="{StaticResource status_label}"/>
            </Grid>
        </DataTemplate>

        <!-- 車両マスタ -->
        <DataTemplate DataType="{x:Type vm:master_vehicles_view_model}">
            <Grid Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="車両マスタ" Style="{StaticResource section_header}"/>
                <TextBlock Grid.Row="1" Text="※「なし」は日報入力の固定値として内部使用するため非表示です"
                           FontSize="11" Foreground="#888" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="＋ 追加" Command="{Binding add_command}" Style="{StaticResource btn_primary}"/>
                    <Button Content="💾 保存" Command="{Binding save_command}" Style="{StaticResource btn_success}"/>
                </StackPanel>

                <DataGrid Grid.Row="3" ItemsSource="{Binding vehicles}"
                          Style="{StaticResource master_grid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="車両名" Binding="{Binding vehicle_name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        <DataGridCheckBoxColumn Header="有効" Binding="{Binding is_active, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="4" Text="{Binding status}" Style="{StaticResource status_label}"/>
            </Grid>
        </DataTemplate>

        <!-- 機材マスタ -->
        <DataTemplate DataType="{x:Type vm:master_equipment_view_model}">
            <Grid Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="機材マスタ（損料日額）" Style="{StaticResource section_header}"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="＋ 追加" Command="{Binding add_command}" Style="{StaticResource btn_primary}"/>
                    <Button Content="💾 保存" Command="{Binding save_command}" Style="{StaticResource btn_success}"/>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding equipment_list}"
                          SelectedItem="{Binding selected_row}"
                          Style="{StaticResource master_grid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="機材・ソフト名" Binding="{Binding equipment_name, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                        <DataGridTextColumn Header="日額損料(円)"   Binding="{Binding daily_rate,     UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridCheckBoxColumn Header="有効"       Binding="{Binding is_active,      UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="備考"           Binding="{Binding note,           UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTemplateColumn Header="操作" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="削除"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.delete_command}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource btn_danger}"
                                            Padding="6,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3" Text="{Binding status}" Style="{StaticResource status_label}"/>
            </Grid>
        </DataTemplate>

        <!-- 旧形式氏名変換 -->
        <DataTemplate DataType="{x:Type vm:master_legacy_name_view_model}">
            <Grid Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="旧形式氏名変換マスタ" Style="{StaticResource section_header}"/>
                <TextBlock Grid.Row="1"
                           Text="旧形式Excelに記載のフルネーム → 現行略称 の変換テーブルです。&#x0a;ベトナム人社員など、苗字のみ抽出できない社員のために使用します。"
                           FontSize="11" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <!-- 追加フォーム -->
                <Border Grid.Row="2" Background="#F0F4F8" CornerRadius="4" Padding="12,10"
                        BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="新規追加" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource brush_accent}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding new_legacy_name, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Padding="6,4">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="旧形式フルネーム（例：NGUYEN VAN PHUC）" Foreground="Gray" Margin="8,4"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding new_display_name, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Padding="6,4"
                                     Tag="略称（例：フック）"/>
                            <Button Grid.Column="4" Content="追加"
                                    Command="{Binding add_command}"
                                    Style="{StaticResource btn_primary}"
                                    Margin="0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 一覧 -->
                <DataGrid Grid.Row="3" ItemsSource="{Binding legacy_names}"
                          IsReadOnly="True" Style="{StaticResource master_grid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="旧形式フルネーム" Binding="{Binding legacy_name}"  Width="*"/>
                        <DataGridTextColumn Header="変換後略称"       Binding="{Binding display_name}" Width="120"/>
                        <DataGridTemplateColumn Header="操作" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="削除"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.delete_command}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource btn_danger}"
                                            Padding="6,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="4" Text="{Binding status}" Style="{StaticResource status_label}"/>
            </Grid>
        </DataTemplate>

        <!-- 金額設定 -->
        <DataTemplate DataType="{x:Type vm:master_amount_view_model}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="500">
                    <TextBlock Text="金額設定" Style="{StaticResource section_header}"/>

                    <!-- 人件費単価 -->
                    <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                            BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="人件費単価" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource brush_accent}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="測量技師 日額単価（円）" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding engineer_daily_rate, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6"/>
                                <TextBlock Grid.Column="2" Text="円/日" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="測量助手 日額単価（円）" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding assistant_daily_rate, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6"/>
                                <TextBlock Grid.Column="2" Text="円/日" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1日基準時間" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding base_hours_per_day, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6"/>
                                <TextBlock Grid.Column="2" Text="h/日" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 交通費設定 -->
                    <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                            BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="交通費設定" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource brush_accent}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="下道 単価" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding road_cost_per_km, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6"/>
                                <TextBlock Grid.Column="2" Text="円/km" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="高速 単価" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding highway_cost_per_km, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6"/>
                                <TextBlock Grid.Column="2" Text="円/km" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="高速→下道 切替距離（往復）" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBox Grid.Column="1" Text="{Binding highway_distance_cap, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6"/>
                                <TextBlock Grid.Column="2" Text="km超" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="※ 保存後、次回の原価集計から新しい設定が反映されます"
                               FontSize="11" Foreground="#E67E22" Margin="0,0,0,12"/>
                    <Button Content="💾 金額設定を保存" Command="{Binding save_command}"
                            Style="{StaticResource btn_success}"
                            HorizontalAlignment="Left" Margin="0"/>
                    <TextBlock Text="{Binding status}" Style="{StaticResource status_label}"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- アーカイブ済み現場 -->
        <DataTemplate DataType="{x:Type vm:master_archived_projects_view_model}">
            <Grid Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="アーカイブ済み現場" Style="{StaticResource section_header}"/>
                <TextBlock Grid.Row="1"
                           Text="アーカイブした現場の一覧です。復元すると原価集計画面に再表示されます。&#x0a;完全削除は関連する原価データもすべて削除されます（元に戻せません）。"
                           FontSize="11" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="2" ItemsSource="{Binding archived_projects}"
                          SelectedItem="{Binding selected_row}"
                          IsReadOnly="True" Style="{StaticResource master_grid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="区分コード" Binding="{Binding category_code}" Width="110"/>
                        <DataGridTextColumn Header="現場名"     Binding="{Binding site_name}"     Width="*"/>
                        <DataGridTextColumn Header="詳細"       Binding="{Binding detail}"        Width="140"/>
                        <DataGridTextColumn Header="属性"       Binding="{Binding attribute}"     Width="90"/>
                        <DataGridTemplateColumn Header="操作" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="復元"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.restore_command}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource btn_primary}"
                                                Padding="8,3" Margin="0,0,6,0"/>
                                        <Button Content="完全削除"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.delete_permanent_command}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource btn_danger}"
                                                Padding="8,3"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3" Text="{Binding status}" Style="{StaticResource status_label}"/>
            </Grid>
        </DataTemplate>

        <!-- ユーザー管理 -->
        <DataTemplate DataType="{x:Type vm:user_management_view_model}">
            <StackPanel Margin="24,20">
                <TextBlock Text="ユーザー管理" Style="{StaticResource section_header}"/>

                <!-- 管理者以外には警告表示 -->
                <Border Background="#FFF3CD" CornerRadius="6" Padding="14,10"
                        Margin="0,0,0,16" BorderThickness="1" BorderBrush="#FFEEBA">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding can_edit}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="⚠️ ユーザー権限の変更は管理者のみ操作できます。"
                               FontSize="12" Foreground="#856404"/>
                </Border>

                <!-- ユーザー一覧 -->
                <DataGrid ItemsSource="{Binding users}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E6ED"
                          RowHeight="40" ColumnHeaderHeight="40"
                          Background="White"
                          BorderThickness="1" BorderBrush="#E0E6ED"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="氏名"       Binding="{Binding user_name}"   Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="PC名"       Binding="{Binding pc_name}"     Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="現在の権限" Binding="{Binding role_label}"  Width="100" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="変更後の権限" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedIndex="{Binding selected_role, UpdateSourceTrigger=PropertyChanged}"
                                              FontSize="12" Margin="4,2">
                                        <ComboBoxItem Content="閲覧"/>
                                        <ComboBoxItem Content="一般"/>
                                        <ComboBoxItem Content="管理者"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="登録日時" Binding="{Binding created_at}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="💾 権限を保存"
                            Command="{Binding save_command}"
                            IsEnabled="{Binding can_edit}"
                            Style="{StaticResource btn_success}"/>
                </StackPanel>
                <TextBlock Text="{Binding status}" Style="{StaticResource status_label}" Margin="0,8,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- ▼▼▼ 追加：タブ並び順リセット ▼▼▼ -->
        <DataTemplate DataType="{x:Type vm:tab_sort_reset_view_model}">
            <StackPanel Margin="24,20">
                <TextBlock Text="タブ並び順リセット" Style="{StaticResource section_header}"/>
                <TextBlock Text="大区分ごとに手動並び替えをリセットして、属性カラー順（デフォルト）に戻します。"
                           FontSize="12" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <ItemsControl ItemsSource="{Binding groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                    BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
