                            BorderBrush="#CCDDF0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{Binding error_log_vm.log_title}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource brush_accent}"
                                       Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding error_log_vm.log_list}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserResizeRows="False" CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#DDDDDD"
                                      SelectionMode="Single"
                                      RowHeight="32" FontSize="12"
                                      Background="White"
                                      BorderThickness="1" BorderBrush="#CCCCCC"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <!-- caught → 赤字 -->
                                            <DataTrigger Binding="{Binding error_type}" Value="caught">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                                <Setter Property="FontWeight"  Value="Normal"/>
                                            </DataTrigger>
                                            <!-- unhandled → 太字 -->
                                            <DataTrigger Binding="{Binding error_type}" Value="unhandled">
                                                <Setter Property="Foreground" Value="#1A3A5C"/>
                                                <Setter Property="FontWeight"  Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="発生日時"  Binding="{Binding occurred_at}" Width="145"/>
                                    <DataGridTextColumn Header="種別"      Binding="{Binding error_type}"  Width="90"/>
                                    <DataGridTextColumn Header="発生箇所"  Binding="{Binding source}"      Width="230"/>
                                    <DataGridTextColumn Header="メッセージ" Binding="{Binding message}"     Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ローディングバー -->
                    <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="4"
                                 VerticalAlignment="Stretch"
                                 Foreground="{DynamicResource brush_accent}"
                                 Visibility="{Binding error_log_vm.is_loading,
                                     Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <!-- ▲▲▲ エラーログ参照セクション終了 ▲▲▲ -->

                <!-- ▼▼▼ [Sprint 5E] 区分結合設定セクション ▼▼▼ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding current_content}"        Value="{x:Null}"/>
                                        <Condition Binding="{Binding is_category_group_page}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="24,20" MaxWidth="700">
                        <TextBlock Text="区分結合設定" Style="{StaticResource section_header}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555" Margin="0,-8,0,16">
                            <Run Text="入力ミスや区分変更で分かれてしまった現場を1つのタブに合算して表示します。"/>
                            <LineBreak/>
                            <Run Text="元データ（日報）は変更されません。表示・集計のみ合算されます。"/>
                        </TextBlock>

                        <!-- 新規追加フォーム -->
                        <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="新規追加" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource brush_accent}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 親コード入力欄（オートコンプリート付き） -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="親区分コード（タブに表示される代表）"
                                                   FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                                        <Grid>
                                            <TextBox Text="{Binding category_group_vm.new_parent_code,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13" Padding="8,6"
                                                     CharacterCasing="Upper"
                                                     x:Name="txt_parent"/>
                                            <Popup IsOpen="{Binding category_group_vm.show_parent_suggestions, Mode=OneWay}"
                                                   PlacementTarget="{Binding ElementName=txt_parent}"
                                                   Placement="Bottom" StaysOpen="False"
                                                   Width="{Binding ElementName=txt_parent, Path=ActualWidth}">
                                                <Border Background="White" BorderBrush="#CCDDF0" BorderThickness="1">
                                                    <ListBox ItemsSource="{Binding category_group_vm.parent_suggestions}"
                                                             SelectedItem="{Binding category_group_vm.selected_parent_suggestion}"
                                                             MaxHeight="160"
                                                             FontSize="12"
                                                             DisplayMemberPath="display_text"/>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="←" FontSize="18"
                                               VerticalAlignment="Bottom" Margin="12,0,12,6"
                                               Foreground="{DynamicResource brush_accent}"/>
                                    <!-- 子コード入力欄（オートコンプリート付き） -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="子区分コード（合算対象）"
                                                   FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                                        <Grid>
                                            <TextBox Text="{Binding category_group_vm.new_child_code,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13" Padding="8,6"
                                                     CharacterCasing="Upper"
                                                     x:Name="txt_child"/>
                                            <Popup IsOpen="{Binding category_group_vm.show_child_suggestions, Mode=OneWay}"
                                                   PlacementTarget="{Binding ElementName=txt_child}"
                                                   Placement="Bottom" StaysOpen="False"
                                                   Width="{Binding ElementName=txt_child, Path=ActualWidth}">
                                                <Border Background="White" BorderBrush="#CCDDF0" BorderThickness="1">
                                                    <ListBox ItemsSource="{Binding category_group_vm.child_suggestions}"
                                                             SelectedItem="{Binding category_group_vm.selected_child_suggestion}"
                                                             MaxHeight="160"
                                                             FontSize="12"
                                                             DisplayMemberPath="display_text"/>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </StackPanel>
                                    <Button Grid.Column="3"
                                            Content="追加"
                                            Command="{Binding category_group_vm.add_command}"
                                            Style="{StaticResource btn_primary}"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="{Binding category_group_vm.status_message}"
                                           FontSize="12" Margin="0,8,0,0"
                                           Foreground="{DynamicResource brush_accent}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 結合設定一覧 -->
                        <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#CCDDF0">
                            <StackPanel>
                                <TextBlock Text="現在の結合設定" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource brush_accent}" Margin="0,0,0,12"/>

                                <!-- 設定なし表示 -->
                                <TextBlock Text="結合設定はまだありません"
                                           FontSize="12" FontStyle="Italic" Foreground="#888">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding category_group_vm.group_items.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <DataGrid ItemsSource="{Binding category_group_vm.group_items}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserResizeRows="False" CanUserReorderColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#DDDDDD"
                                          SelectionMode="Single"
                                          RowHeight="36" FontSize="12"
                                          Background="White"
                                          BorderThickness="1" BorderBrush="#CCCCCC">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding category_group_vm.group_items.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="親区分コード（代表）"
                                                            Binding="{Binding parent_code}"
                                                            Width="200"/>
                                        <DataGridTextColumn Header="←" Width="40"/>
                                        <DataGridTextColumn Header="子区分コード（合算対象）"
                                                            Binding="{Binding child_code}"
                                                            Width="200"/>
                                        <DataGridTextColumn Header="登録日時"
                                                            Binding="{Binding created_at}"
                                                            Width="150"/>
                                        <DataGridTemplateColumn Header="操作" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="削除"
                                                            Command="{Binding DataContext.category_group_vm.delete_command,
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource btn_danger}"
                                                            Padding="8,3"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Width="*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="※ 削除後、原価集計画面を🔄更新すると個別タブに戻ります"
                                           FontSize="11" Foreground="#E67E22" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- ▲▲▲ 区分結合設定セクション終了 ▲▲▲ -->

                <!-- ▼▼▼ [Sprint 5F] バックアップ復元セクション ▼▼▼ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding current_content}"          Value="{x:Null}"/>
                                        <Condition Binding="{Binding is_backup_restore_page}"   Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="24,20" MaxWidth="760">
                        <TextBlock Text="バックアップ復元" Style="{StaticResource section_header}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555" Margin="0,-8,0,16">
                            <Run Text="NASまたはローカルに保存されたバックアップファイルから復元します。"/>
                            <LineBreak/>
                            <Run Text="復元後はアプリが自動再起動されます。現在のデータは上書きされるため注意してください。"/>
                        </TextBlock>

                        <!-- 操作バー -->
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right"
                                    Content="🔄 再読み込み"
                                    Command="{Binding backup_restore_vm.reload_command}"
                                    Style="{StaticResource btn_primary}"
                                    Padding="12,6"/>
                            <TextBlock Text="{Binding backup_restore_vm.status_message}"
                                       FontSize="12" Foreground="{DynamicResource brush_accent}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- ローディング -->
                        <ProgressBar IsIndeterminate="True" Height="3"
                                     Foreground="{DynamicResource brush_accent}"
                                     Background="Transparent" BorderThickness="0"
                                     Margin="0,0,0,8">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding backup_restore_vm.is_busy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <!-- バックアップ一覧 -->
                        <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="バックアップ一覧" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource brush_accent}" Margin="0,0,0,12"/>

                                <!-- 件数0のとき -->
                                <TextBlock Text="バックアップファイルが見つかりませんでした"
                                           FontSize="12" FontStyle="Italic" Foreground="#888">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding backup_restore_vm.backup_items.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <DataGrid ItemsSource="{Binding backup_restore_vm.backup_items}"
                                          SelectedItem="{Binding backup_restore_vm.selected_item}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserResizeRows="False" CanUserReorderColumns="False"
                                          SelectionMode="Single"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#DDDDDD"
                                          RowHeight="36" FontSize="12"
                                          Background="White"
                                          MaxHeight="360"
                                          BorderThickness="1" BorderBrush="#CCCCCC">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding backup_restore_vm.backup_items.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="種別"
                                                            Binding="{Binding kind_text}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="作成日時"
                                                            Binding="{Binding created_at}"
                                                            Width="160"/>
                                        <DataGridTextColumn Header="ファイル名"
                                                            Binding="{Binding file_name}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="サイズ"
                                                            Binding="{Binding file_size}"
                                                            Width="80"/>
                                        <DataGridTextColumn Header="保存場所"
                                                            Binding="{Binding location}"
                                                            Width="80"/>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <!-- 復元前退避ファイルはオレンジ背景で強調 -->
                                                <DataTrigger Binding="{Binding is_safety_backup}" Value="True">
                                                    <Setter Property="Background" Value="#FFF3E0"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource brush_accent_light}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- 復元ボタン -->
                        <Border Background="#FFF3E0" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#FFCC80">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#795548"
                                           Margin="0,0,0,10">
                                    <Run FontWeight="Bold">⚠ 注意：</Run>
                                    <Run>リストからバックアップを選択して「復元」を押してください。現在のDBは上書きされます。</Run>
                                </TextBlock>
                                <Button Content="⬆ 選択したバックアップに復元"
                                        Command="{Binding backup_restore_vm.restore_command}"
                                        IsEnabled="{Binding backup_restore_vm.can_restore}"
                                        Background="#E67E22" Foreground="White"
                                        FontWeight="Bold" FontSize="13"
                                        Padding="16,8" BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- ▲▲▲ バックアップ復元セクション終了 ▲▲▲ -->

                <!-- ▼▼▼ 追加：詳細設定セクション（selected_nav.key == "advanced" の場合に表示） ▼▼▼ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- 詳細設定：current_content=null かつ is_advanced_page=True の場合に表示 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding current_content}" Value="{x:Null}"/>
                                        <Condition Binding="{Binding is_advanced_page}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="24,20" MaxWidth="600">

                        <TextBlock Text="詳細設定" Style="{StaticResource section_header}"/>
                        <TextBlock Text="※ この設定はこのPCのみに保存されます。カラー・フォント・色帯は即時反映。起動ページ・大区分記憶は「保存して再起動」で反映されます。"
                                   FontSize="11" Foreground="#E67E22" Margin="0,-8,0,16" TextWrapping="Wrap"/>

                        <!-- カラーテーマ -->
                        <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="カラーテーマ" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource brush_accent}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <RadioButton Content="水色（デフォルト）"
                                                 IsChecked="{Binding theme, Converter={StaticResource StrEqual}, ConverterParameter=cyan}"
                                                 GroupName="theme" FontSize="12" Margin="0,0,16,6"/>
                                    <RadioButton Content="濃い青"
                                                 IsChecked="{Binding theme, Converter={StaticResource StrEqual}, ConverterParameter=blue}"
                                                 GroupName="theme" FontSize="12" Margin="0,0,16,6"/>
                                    <RadioButton Content="緑"
                                                 IsChecked="{Binding theme, Converter={StaticResource StrEqual}, ConverterParameter=green}"
                                                 GroupName="theme" FontSize="12" Margin="0,0,16,6"/>
                                    <RadioButton Content="パープル"
                                                 IsChecked="{Binding theme, Converter={StaticResource StrEqual}, ConverterParameter=purple}"
                                                 GroupName="theme" FontSize="12" Margin="0,0,16,6"/>
                                    <RadioButton Content="グレー"
                                                 IsChecked="{Binding theme, Converter={StaticResource StrEqual}, ConverterParameter=gray}"
                                                 GroupName="theme" FontSize="12" Margin="0,0,16,6"/>
                                    <RadioButton Content="ピンク"
                                                 IsChecked="{Binding theme, Converter={StaticResource StrEqual}, ConverterParameter=pink}"
                                                 GroupName="theme" FontSize="12" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ③ フォントサイズ -->
                        <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="フォントサイズ" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource brush_accent}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <RadioButton Content="小"
                                                 IsChecked="{Binding font_size, Converter={StaticResource StrEqual}, ConverterParameter=small}"
                                                 GroupName="font_size" FontSize="12" Margin="0,0,16,0"/>
                                    <RadioButton Content="中（デフォルト）"
                                                 IsChecked="{Binding font_size, Converter={StaticResource StrEqual}, ConverterParameter=medium}"
                                                 GroupName="font_size" FontSize="12" Margin="0,0,16,0"/>
                                    <RadioButton Content="大"
                                                 IsChecked="{Binding font_size, Converter={StaticResource StrEqual}, ConverterParameter=large}"
                                                 GroupName="font_size" FontSize="12" Margin="0,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ④ 起動時のページ -->
                        <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="起動時に表示するページ" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource brush_accent}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <RadioButton Content="ダッシュボード（デフォルト）"
                                                 IsChecked="{Binding startup_page, Converter={StaticResource StrEqual}, ConverterParameter=dashboard}"
                                                 GroupName="startup_page" FontSize="12" Margin="0,0,16,0"/>
                                    <RadioButton Content="原価集計"
                                                 IsChecked="{Binding startup_page, Converter={StaticResource StrEqual}, ConverterParameter=cost}"
                                                 GroupName="startup_page" FontSize="12" Margin="0,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ⑤ 現場タブの色帯の幅 -->
                        <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="現場タブの色帯の幅" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource brush_accent}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <RadioButton Content="細"
                                                 IsChecked="{Binding tab_color_bar_width, Converter={StaticResource IntEqual}, ConverterParameter=4}"
                                                 GroupName="tab_bar" FontSize="12" Margin="0,0,16,0"/>
                                    <RadioButton Content="普通（デフォルト）"
                                                 IsChecked="{Binding tab_color_bar_width, Converter={StaticResource IntEqual}, ConverterParameter=6}"
                                                 GroupName="tab_bar" FontSize="12" Margin="0,0,16,0"/>
                                    <RadioButton Content="太"
                                                 IsChecked="{Binding tab_color_bar_width, Converter={StaticResource IntEqual}, ConverterParameter=10}"
                                                 GroupName="tab_bar" FontSize="12" Margin="0,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ⑥ 大区分の選択を記憶する -->
                        <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="大区分の選択を記憶する"
                                          IsChecked="{Binding remember_group}"
                                          FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="ONにすると前回選択していた大区分（EA・RD等）を記憶して次回起動時に自動選択します。"
                                           FontSize="11" Foreground="#666" Margin="20,0,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ⑦ 選択タブの拡大表示 -->
                        <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="選択中の現場タブを拡大表示する"
                                          IsChecked="{Binding tab_enlarge_on_select}"
                                          FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="ONにすると選択中の現場タブが大きく表示されます。OFFにするとすべてのタブが均一サイズになります。即時反映されます。"
                                           FontSize="11" Foreground="#666" Margin="20,0,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="💾 詳細設定を保存"
                                            Click="btn_save_advanced_Click"
                                            Style="{StaticResource btn_success}"/>
                            <!-- ▼▼▼ タブ表示モード・起動ページ等は再起動で反映 ▼▼▼ -->
                            <Button Content="🔄 保存して再起動"
                                            Click="btn_save_and_restart_Click"
                                            Background="#E67E22" Foreground="White"
                                            FontSize="12" FontWeight="Bold"
                                            Padding="14,6" Cursor="Hand"
                                            BorderThickness="0"/>
                        </StackPanel>

                        <TextBlock Text="{Binding status_message}" Style="{StaticResource status_label}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- DB設定セクション（selected_nav.key == "db" の場合に表示） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- DB設定：current_content=null かつ 詳細設定ページでない かつ エラーログページでない場合に表示 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding current_content}" Value="{x:Null}"/>
                                        <Condition Binding="{Binding is_advanced_page}"  Value="False"/>
                                        <Condition Binding="{Binding is_error_log_page}"      Value="False"/>
                                        <Condition Binding="{Binding is_category_group_page}" Value="False"/>
                                        <!-- ▼ [Sprint 5E] 追加 -->
                                        <Condition Binding="{Binding is_backup_restore_page}" Value="False"/>
                                        <!-- ▼ [Sprint 5F] 追加 -->
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="24,20" MaxWidth="600">

                        <TextBlock Text="DB設定" Style="{StaticResource section_header}"/>

                        <!-- DB保存先セクション -->
                        <Border Background="#F0F4F8" CornerRadius="6" Padding="16,14"
                                BorderThickness="1" BorderBrush="#CCDDF0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="データベース保存先" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource brush_accent}" Margin="0,0,0,12"/>

                                <TextBlock Text="現在のDBパス：" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                <Border Background="White" BorderBrush="#BCD" BorderThickness="1"
                                        CornerRadius="3" Padding="8,6" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding current_db_path}" FontSize="11"
                                               Foreground="#333" TextWrapping="Wrap"/>
                                </Border>

                                <CheckBox Content="NASにデータベースを保存する"
                                          IsChecked="{Binding nas_enabled}"
                                          FontSize="13" Margin="0,0,0,10"/>

                                <TextBlock Text="NASパス：" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding nas_path, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="8,6" Margin="0,0,0,4"
                                         IsEnabled="{Binding nas_enabled}"/>
                                <TextBlock Text="例：\\NAS7E6AA6\Public\000_事務関係\100_SE管理\01_EABASE Series\00_Database\ea_core.db"
                                           FontSize="10" Foreground="#888" Margin="0,0,0,6"/>

                                <!-- テスト用パス クイックセットボタン -->
                                <Border Background="#FFFBE6" BorderBrush="#F0C040"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧪 テスト用：" FontSize="11"
                                                   Foreground="#B8860B" VerticalAlignment="Center"
                                                   Margin="0,0,6,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="\\NAS7E6AA6\Public\000_事務関係\100_SE管理\99_Test\01_CostManager\ea_core.db"
                                                   FontSize="10" Foreground="#555"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   TextWrapping="Wrap" MaxWidth="300"/>
                                        <Button Content="セット"
                                                FontSize="11" Padding="8,4"
                                                Background="#F0C040" Foreground="#333"
                                                BorderThickness="0" Cursor="Hand"
                                                Click="btn_set_test_path_Click"
                                                ToolTip="テスト用DBパスをNASパス欄にセットします"/>
                                    </StackPanel>
                                </Border>

                                <!-- ▼▼▼ 追加⑨：標準DB（本番NAS）クイックセットボタン ▼▼▼ -->
                                <Border Background="#EAF6FF" BorderBrush="#5BA4CF"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="10,8" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏢 標準DB：" FontSize="11"
                                                   Foreground="#1A5C99" VerticalAlignment="Center"
                                                   Margin="0,0,6,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="\\NAS7E6AA6\Public\000_事務関係\100_SE管理\01_EABASE Series\00_Database\ea_core.db"
                                                   FontSize="10" Foreground="#555"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   TextWrapping="Wrap" MaxWidth="300"/>
                                        <Button Content="セット"
                                                FontSize="11" Padding="8,4"
                                                Background="{DynamicResource brush_accent}" Foreground="White"
                                                BorderThickness="0" Cursor="Hand"
                                                Click="btn_set_production_path_Click"
                                                ToolTip="標準DB（本番NAS）のパスをNASパス欄にセットします"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="接続確認"
                                            Command="{Binding check_nas_command}"
                                            IsEnabled="{Binding nas_enabled}"
                                            Style="{StaticResource btn_primary}"/>
                                    <TextBlock Text="{Binding nas_status_message}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{Binding nas_status_color}"/>
                                </StackPanel>

                                <!-- ▼▼▼ 修正：Commandバインド → Clickハンドラーに変更（保存後に自動再起動）▼▼▼ -->
                                <Button Content="設定を保存して再起動"
                                        Click="btn_save_db_and_restart_Click"
                                        Style="{StaticResource btn_success}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- ローカルDBパス -->
                        <Border Background="#FFF8F0" CornerRadius="6" Padding="14,12"
                                BorderThickness="1" BorderBrush="#F0CCA0">
                            <StackPanel>
                                <TextBlock Text="ローカル保存先（NAS未使用時）" FontWeight="Bold"
                                           FontSize="12" Foreground="#E67E22" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding local_db_path}" FontSize="11"
                                           Foreground="#555" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ステータス -->
                        <TextBlock Text="{Binding status_message}" Style="{StaticResource status_label}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- current_content が null のとき Collapsed、それ以外は Visible -->
                <ContentControl Content="{Binding current_content}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding current_content}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

            </Grid>
        </Grid>

        <!-- ローディングオーバーレイ -->
        <Grid Grid.Row="1" Background="#80000000"
              Visibility="{Binding is_busy, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding status_message}" FontSize="13"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
