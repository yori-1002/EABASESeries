<Window x:Class="EA_CostManager.Views.ArchivedTabsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アーカイブ済みタブの復元"
        Width="400" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ItemStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#EEF4FB" Padding="12,8"
                CornerRadius="4" Margin="0,0,0,16">
            <TextBlock Text="復元するタブにチェックを入れてください"
                       FontSize="12" Foreground="#444"/>
        </Border>

        <!-- タブ一覧（チェックボックス） -->
        <Border Grid.Row="1" BorderBrush="#DDEEFF" BorderThickness="1"
                CornerRadius="4" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="panel_tabs"/>
            </ScrollViewer>
        </Border>

        <!-- 全選択・全解除 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="すべて選択" Width="100" Padding="0,5"
                    Margin="0,0,8,0" Click="btn_select_all_Click"/>
            <Button Content="すべて解除" Width="100" Padding="0,5"
                    Click="btn_deselect_all_Click"/>
        </StackPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btn_cancel" Content="キャンセル"
                    Width="90" Padding="0,7"
                    Margin="0,0,8,0" Click="btn_cancel_Click"/>
            <Button x:Name="btn_restore" Content="復元する"
                    Width="90" Padding="0,7"
                    Background="#2E75B6" Foreground="White"
                    Click="btn_restore_Click"/>
        </StackPanel>
    </Grid>
</Window>
