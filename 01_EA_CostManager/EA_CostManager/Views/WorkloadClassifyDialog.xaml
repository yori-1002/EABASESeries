<Window x:Class="EA_CostManager.Views.WorkloadClassifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:EA_CostManager.Converters"
        Title="分類設定"
        Width="1020" Height="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F8FB">

    <!-- ▼ 追加 [Sprint 7C-1]：工数表の分類設定ダイアログ
         【設計方針】
         ・編集内容はすべてメモリ上で保持し、「保存」を押したときにまとめてDBへ反映する
           （保存反映方式）。キャンセルすれば編集内容は破棄される。
         ・区分名は第1キーワードとして自動的に判定に使われる。
           ただし「その他」のように区分名が判定語として機能しない場合があるため、
           use_name_as_keyword のチェックでON/OFFを切り替えられる。
         ・キーワードを入力すると、その語が業務内容に何件ヒットするかを即時にプレビュー表示する
           （保存前に効果が分かるようにするため）。 -->

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 区分の設定（上）とサブ分類の設定（下）で高さを分け合う -->
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== ヘッダー ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding project_title}"
                       FontSize="16" FontWeight="Bold" Foreground="#123" />
            <TextBlock Text="区分名はそのままキーワードとして判定に使われます。表記ゆれや別の言い方を拾いたい場合は、追加キーワードを登録してください。サブ分類は下の一覧で管理し、どの区分タブに出すかを「適用する区分タブ」のチェックで選べます。"
                       FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ===== 本体：左＝区分一覧／右＝選択中区分の設定 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═ 左：業務区分の一覧 ═ -->
            <Border Grid.Column="0" Background="White" CornerRadius="6"
                    BorderBrush="#DDE6EF" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="業務区分（上から順に判定されます）"
                               FontSize="12" FontWeight="Bold" Foreground="#333"
                               Margin="0,0,0,6" />

                    <!-- 件数は「現在のキーワードで何件ヒットするか」のプレビュー -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding categories}"
                              SelectedItem="{Binding selected_category}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF2F6"
                              RowHeaderWidth="0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="区分名" Binding="{Binding name}" Width="*" />
                            <DataGridTextColumn Header="該当件数" Binding="{Binding hit_count}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 区分の操作：追加・削除・並び替え（並び順＝判定の優先順） -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="＋ 区分追加" Command="{Binding add_category_command}"
                                Padding="10,5" FontSize="12" Margin="0,0,6,0" />
                        <Button Content="削除" Command="{Binding delete_category_command}"
                                Padding="10,5" FontSize="12" Margin="0,0,6,0" />
                        <Button Content="▲" Command="{Binding move_up_command}"
                                Padding="10,5" FontSize="12" Margin="0,0,4,0"
                                ToolTip="判定の優先順位を上げます" />
                        <Button Content="▼" Command="{Binding move_down_command}"
                                Padding="10,5" FontSize="12"
                                ToolTip="判定の優先順位を下げます" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═ 右：選択中の区分の設定 ═ -->
            <Border Grid.Column="2" Background="White" CornerRadius="6"
                    BorderBrush="#DDE6EF" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 区分名 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="区分名（この語がそのままキーワードになります）"
                                   FontSize="12" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4" />
                        <TextBox Text="{Binding selected_category.name, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding has_selection}"
                                 FontSize="13" Padding="6,4" />
                    </StackPanel>

                    <!-- 区分名をキーワードとして使うか -->
                    <CheckBox Grid.Row="1"
                              Content="区分名をキーワードとして使う（「その他」など、判定語にしたくない場合は外してください）"
                              IsChecked="{Binding selected_category.use_name_as_keyword}"
                              IsEnabled="{Binding has_selection}"
                              FontSize="12" Margin="0,0,0,12" />

                    <!-- 追加キーワード -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="追加キーワード（表記ゆれ・別の言い方を拾います）"
                                   FontSize="12" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding selected_category.keywords}"
                                  SelectedItem="{Binding selected_keyword}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEF2F6"
                                  RowHeaderWidth="0"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="キーワード" Binding="{Binding keyword}" Width="*" />
                                <DataGridTextColumn Header="該当件数" Binding="{Binding hit_count}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Margin" Value="0,0,8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- キーワードの追加欄：入力すると即座に該当件数をプレビュー表示する -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding new_keyword, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding has_selection}"
                                 FontSize="13" Padding="6,4" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding new_keyword_hint}"
                                   VerticalAlignment="Center" Margin="10,0,10,0"
                                   FontSize="12" Foreground="#0F5FA8" />
                        <Button Grid.Column="2" Content="＋ 追加"
                                Command="{Binding add_keyword_command}"
                                Padding="12,5" FontSize="12" />
                    </Grid>
                    <Button Grid.Row="4" Content="選択したキーワードを削除"
                            Command="{Binding delete_keyword_command}"
                            HorizontalAlignment="Left" Padding="10,5" FontSize="12" Margin="0,6,0,12" />

                    <!-- ▼ 修正 [Sprint 7D]：サブ分類で分けるかどうかだけをこの区分の設定として持つ。
                         どのサブ分類を出すかは下の「サブ分類」欄でチェックして決める。 -->
                    <CheckBox Grid.Row="5" VerticalAlignment="Top"
                              Content="この区分ではサブ分類で分けない（区分の合計だけを表示します）"
                              IsChecked="{Binding is_mode_none}"
                              IsEnabled="{Binding has_selection}"
                              FontSize="12" Margin="0,4,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ サブ分類（案件単位で管理し、適用先の区分をチェックで選ぶ） ═══
             ▼ 追加 [Sprint 7D]
             以前はサブ分類を選択中の区分の中に置き、「案件共通」で追加すると
             全ての区分タブに出てしまっていた。サブ分類は案件単位の資産として一覧で扱い、
             右のチェックで「どの区分タブに出すか」を1件ずつ指定する形に変更した。 -->
        <Border Grid.Row="2" Background="White" CornerRadius="6"
                BorderBrush="#DDE6EF" BorderThickness="1" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="サブ分類（区分の中をさらに分けます。橋名など）"
                           FontSize="12" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4" />
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="適用する区分タブ"
                           FontSize="12" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4" />

                <!-- ▼ 修正 [7C-fix4]：x:Name を付与し、保存時にセル編集を強制コミットする。
                     WPFのDataGridはセルが編集モードのままだと、入力値が
                     バインディングソース（edit_subgroup）へ書き戻されない。
                     そのまま保存すると、画面に見えている文字が保存されないため、
                     コードビハインドの save_click で CommitEdit() を呼ぶ。 -->
                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                              x:Name="subgroup_grid"
                              ItemsSource="{Binding subgroups}"
                              SelectedItem="{Binding selected_subgroup}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF2F6"
                              RowHeaderWidth="0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <!-- ▼ 修正 [7C-fix4]：UpdateSourceTrigger=PropertyChanged を指定する。
                                 既定（LostFocus）だと、セルが編集中のまま「保存」を押した際に
                                 入力値がモデルへ書き戻されず、保存されないため。
                                 セルはダブルクリック（またはF2）で編集できる。 -->
                            <DataGridTextColumn Header="サブ分類名"
                                                Binding="{Binding name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="180" />
                            <DataGridTextColumn Header="キーワード（カンマ区切り。空欄ならサブ分類名で判定）"
                                                Binding="{Binding keywords_text, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <!-- ▼ 追加 [Sprint 7D]：この行がいくつの区分タブに出るか。
                                 「未設定」はどこにも表示されない状態を表す -->
                            <DataGridTextColumn Header="適用先" Binding="{Binding applied_text}"
                                                Width="70" IsReadOnly="True" />
                            <!-- ▼ 追加 [7C-fix4]：該当件数（保存前に効果を確認できるようにする） -->
                            <DataGridTextColumn Header="該当件数" Binding="{Binding hit_count}"
                                                Width="70" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="＋ サブ分類追加" Command="{Binding add_subgroup_command}"
                                Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                ToolTip="左で選択中の区分にだけ適用された状態で追加されます。" />
                        <Button Content="削除" Command="{Binding delete_subgroup_command}"
                                Padding="10,5" FontSize="12" />
                    </StackPanel>
                </Grid>

                <!-- 選択中のサブ分類を、どの区分タブに出すか -->
                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#DDE6EF" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding subgroup_targets}" Margin="8,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 区分名は edit_category を直接バインドするため、
                                             区分名を変更するとこの表示も追従する -->
                                        <CheckBox Content="{Binding category.name}"
                                                  IsChecked="{Binding is_checked}"
                                                  FontSize="12" Margin="0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding has_subgroup_selection, Converter={StaticResource BoolToVis}}">
                        <Button Content="全選択" Command="{Binding select_all_targets_command}"
                                Padding="10,5" FontSize="12" Margin="0,0,6,0" />
                        <Button Content="全解除" Command="{Binding clear_all_targets_command}"
                                Padding="10,5" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 状態メッセージ ===== -->
        <TextBlock Grid.Row="3" Text="{Binding status_message}"
                   FontSize="12" Foreground="#0F5FA8" Margin="2,10,0,0"
                   TextWrapping="Wrap" />

        <!-- ===== フッター ===== -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="他案件からコピー..."
                    Command="{Binding copy_from_project_command}"
                    Padding="14,7" FontSize="12"
                    ToolTip="他の案件で作成した業務区分・キーワードを選んで取り込みます。" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="キャンセル" IsCancel="True"
                        Padding="20,7" FontSize="12" Margin="0,0,8,0" />
                <Button Content="保存" Click="save_click"
                        Padding="28,7" FontSize="12" FontWeight="Bold"
                        Background="#0F5FA8" Foreground="White" BorderThickness="0" />
            </StackPanel>
            <TextBlock />
        </DockPanel>
    </Grid>
</Window>
