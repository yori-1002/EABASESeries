<Window x:Class="EA_CostManager.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ヘルプ - ショートカットキー一覧"
        Width="620" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <!-- セクション見出しスタイル -->
        <Style x:Key="section_header" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource brush_accent}"/>
            <Setter Property="Margin"     Value="0,12,0,6"/>
        </Style>
        <!-- キー表示ラベル -->
        <Style x:Key="key_label" TargetType="Border">
            <Setter Property="Background"   Value="#ECEFF1"/>
            <Setter Property="BorderBrush"  Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding"      Value="8,3"/>
            <Setter Property="Margin"       Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{DynamicResource brush_accent}" Padding="20,12">
            <TextBlock Text="ヘルプ  ―  ショートカットキーと操作説明"
                       Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <!-- コンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,12,24,16">

                <!-- ショートカットキー一覧 -->
                <TextBlock Text="ショートカットキー一覧" Style="{StaticResource section_header}"/>

                <!-- テーブルヘッダー -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="キー"
                               FontSize="11" Foreground="#888" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="操作"
                               FontSize="11" Foreground="#888" FontWeight="SemiBold"/>
                </Grid>
                <Rectangle Height="1" Fill="#E0E0E0" Margin="0,0,0,4"/>

                <!-- 各ショートカット行 -->
                <ItemsControl>
                    <ItemsControl.Items>
                        <!-- Undo/Redo -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + Z" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="元に戻す（現場属性・区分コード・現場名/詳細の変更）"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + Y" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="やり直し（最大10回）"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 更新 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + R" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="🔄 更新（他ユーザーの変更を手動反映）"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 検索 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + F" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="現場タブ検索欄にフォーカスを移動"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 印刷 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + P" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="印刷ダイアログを開く（選択中の現場）"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Excel -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + E" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Excel出力ダイアログを開く（選択中の現場）"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 編集 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="F2" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="現場編集ダイアログを開く（選択中の現場）"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 絞り込みタブ追加 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + N" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="絞り込みタブを追加（選択中の現場）"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Ctrl+U：人員単価変更 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + U" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="人員単価変更ダイアログを開く（選択中の現場）"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Ctrl+M：月度折りたたみ -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + M" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="月度を折りたたむ / 展開（トグル）"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Ctrl+Shift+M：年度折りたたみ -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl+Shift+M" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="年度を折りたたむ / 展開（トグル）"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- ヘルプ -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource key_label}" HorizontalAlignment="Left">
                                <TextBlock Text="F1" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="このヘルプダイアログを表示"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </ItemsControl.Items>
                </ItemsControl>

                <!-- 操作説明 -->
                <TextBlock Text="主な操作ボタンの説明" Style="{StaticResource section_header}"/>
                <Rectangle Height="1" Fill="#E0E0E0" Margin="0,0,0,8"/>

                <StackPanel>
                    <TextBlock FontSize="12" Margin="0,3" TextWrapping="Wrap">
                        <Run FontWeight="Bold">🔄 更新：</Run>
                        <Run>他のPCでデータが更新された場合に手動で反映します。自動更新は60秒ごとに行われます。</Run>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,3" TextWrapping="Wrap">
                        <Run FontWeight="Bold">+ 絞り込みタブ追加：</Run>
                        <Run>月度・作業者などで絞り込んだビューを追加します。タブごとに異なる条件を設定できます。</Run>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,3" TextWrapping="Wrap">
                        <Run FontWeight="Bold">人員単価を変更：</Run>
                        <Run>選択中の絞り込みタブに対して技師・助手・個人別の単価を上書き設定します。</Run>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,3" TextWrapping="Wrap">
                        <Run FontWeight="Bold">▶▶ 月度を折りたたむ / ▼▼ 展開：</Run>
                        <Run>全月度を一括で折りたたみ・展開します。折りたたみ状態はユーザーごとにDBに保存されます。</Run>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,3" TextWrapping="Wrap">
                        <Run FontWeight="Bold">現場タブの右クリック：</Run>
                        <Run>属性変更（契約済/契約前など）・現場名編集・アーカイブ（非表示化）ができます。</Run>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,3" TextWrapping="Wrap">
                        <Run FontWeight="Bold">Ctrl+Z / Ctrl+Y（Undo/Redo）：</Run>
                        <Run>属性変更・区分コード変更・現場名/詳細変更の直前状態に戻せます。最大10回まで記録されます。</Run>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,3" TextWrapping="Wrap">
                        <Run FontWeight="Bold">Ctrl+U（人員単価変更）：</Run>
                        <Run>選択中の現場の技師・助手・個人別単価を設定するダイアログを開きます。</Run>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,3" TextWrapping="Wrap">
                        <Run FontWeight="Bold">Ctrl+M / Ctrl+Shift+M（折りたたみ）：</Run>
                        <Run>月度/年度の折りたたみをトグルします。</Run>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- フッター -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="16,10"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="EA_CostManager  ―  EABASE Series"
                           FontSize="11" Foreground="#999" VerticalAlignment="Center"/>
                <Button Content="閉じる"
                        HorizontalAlignment="Right"
                        Padding="20,6"
                        Click="btn_close_Click"
                        IsDefault="True"
                        Background="{DynamicResource brush_accent}"
                        Foreground="White"
                        BorderThickness="0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
