<Window x:Class="EA_CostManager.Views.TabNameInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="タブ名を設定"
        Width="360" Height="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 説明ラベル -->
		<TextBlock Grid.Row="0" Text="タブ名を入力してください"
                   Margin="0,0,0,8" FontSize="13"/>

		<!-- タブ名入力 -->
		<TextBox x:Name="txt_name" Grid.Row="1"
                 Height="32" Padding="6,0"
                 VerticalContentAlignment="Center"
                 MaxLength="50"
                 Margin="0,0,0,16"/>

		<!-- ボタン -->
		<StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
			<Button Content="キャンセル"
                    Width="90" Height="32" Margin="0,0,8,0"
                    Click="btn_cancel_Click"/>
			<Button Content="OK"
                    Width="90" Height="32"
                    IsDefault="True"
                    Click="btn_ok_Click"/>
		</StackPanel>
	</Grid>
</Window>
