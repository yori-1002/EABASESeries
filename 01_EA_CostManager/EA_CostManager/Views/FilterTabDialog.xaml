<Window x:Class="EA_CostManager.Views.FilterTabDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EA_CostManager.Views"
        xmlns:conv="clr-namespace:EA_CostManager.Converters"
        Title="絞り込み集計タブの作成"
        Width="620" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="NoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- ▼▼▼ 追加：件数確認エリア行 ▼▼▼ -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#EEF4FB" Padding="12,8"
                CornerRadius="4" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="区分コード：" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="txt_header_code" FontSize="12"
                               Foreground="#2E75B6" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock FontSize="11" Foreground="#555"
                           Text="条件を設定して絞り込んだ集計タブを作成します。空欄は全件対象です。"/>
            </StackPanel>
        </Border>

        <!-- 入力フォーム -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- タブ名 -->
                <TextBlock Text="タブ名 *" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txt_tab_name" FontSize="12" Padding="6,5"
                         BorderBrush="#CCCCCC" Margin="0,0,0,4"/>
                <TextBlock Text="例：2026年3月度・計測作業" Style="{StaticResource NoteStyle}"/>

                <!-- 対象月度 -->
                <TextBlock Text="対象月度（任意）" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="cmb_month" FontSize="12" Padding="6,5"
                          Margin="0,0,0,4" IsEditable="True"
                          IsEnabled="{Binding ElementName=chk_use_date_range, Path=IsChecked, Converter={StaticResource InverseBool}}"
                          SelectionChanged="filter_condition_changed"
                          KeyUp="filter_condition_changed_key"/>
                <TextBlock Text="空欄 = 全月度対象（期間指定ONの場合は無効）" Style="{StaticResource NoteStyle}"/>

                <!-- ▼▼▼ 追加：期間指定チェックボックスとカレンダー ▼▼▼ -->
                <Border Background="#F0F8FF" CornerRadius="4" Padding="10,8"
                        Margin="0,0,0,8" BorderBrush="#B0D0F0" BorderThickness="1">
                    <StackPanel>
                        <!-- 期間指定チェックボックス -->
                        <CheckBox x:Name="chk_use_date_range"
                                  Content="期間指定する（開始日〜終了日）"
                                  FontSize="12" FontWeight="SemiBold"
                                  Foreground="#2E75B6"
                                  Checked="chk_use_date_range_Changed"
                                  Unchecked="chk_use_date_range_Changed"/>
                        <TextBlock Margin="20,4,0,0" FontSize="10" Foreground="#666"
                                   TextWrapping="Wrap"
                                   Text="日付範囲で絞り込みます。月度フィルターとは独立して動作します。"/>

                        <!-- カレンダー本体（チェックON時のみ表示） -->
                        <views:MonthRangeCalendar x:Name="calendar_picker"
                                                   Margin="0,10,0,0"
                                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- 作業内容キーワード -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="作業内容キーワード（任意）" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txt_content" FontSize="12" Padding="6,5"
                                 BorderBrush="#CCCCCC"
                                 Height="70" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="filter_condition_changed_text"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="マッチング" Style="{StaticResource LabelStyle}"
                                       Margin="0,0,4,0"/>
                            <!-- ▼▼▼ 追加：マッチング説明ツールチップ ▼▼▼ -->
                            <TextBlock Text="ⓘ" FontSize="11" Foreground="#2E75B6"
                                       VerticalAlignment="Center" Cursor="Help"
                                       ToolTipService.ShowDuration="30000"
                                       ToolTipService.InitialShowDelay="200">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Margin="0,0,0,6"
                                                       Text="マッチング方式の説明"/>
                                            <TextBlock FontWeight="SemiBold" Text="■ 部分一致"/>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="260" Margin="8,2,0,8"
                                                       Text="作業内容にキーワードが含まれていればヒット&#x0a;例：「計測」→「Z+F計測作業」もヒット"/>
                                            <TextBlock FontWeight="SemiBold" Text="■ 完全一致"/>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="260" Margin="8,2,0,8"
                                                       Text="作業内容を「・」で分割した項目のどれかが&#x0a;キーワードと完全に一致する場合のみヒット&#x0a;例：「計測」→「Z+F計測作業」はヒットしない&#x0a;　　「計測」→「計測」のみの行がヒット"/>
                                            <TextBlock FontWeight="SemiBold" Text="■ カンマ区切りOR検索（両方式共通）"/>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="260" Margin="8,2,0,0"
                                                       Text="「,」で区切ると複数キーワードのどれかに&#x0a;一致する行がヒット&#x0a;例：「計測,測量」→どちらかを含む行"/>
                                        </StackPanel>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <ComboBox x:Name="cmb_match" FontSize="12" Padding="6,5"
                                  SelectedIndex="0"
                                  SelectionChanged="filter_condition_changed">
                            <ComboBoxItem Content="部分一致"/>
                            <ComboBoxItem Content="完全一致"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock Text="複数キーワードは「,」で区切ってください（OR検索）"
                           Style="{StaticResource NoteStyle}"/>

                <!-- 氏名 -->
                <TextBlock Text="氏名フィルター（任意）" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txt_names" FontSize="12" Padding="6,5"
                         BorderBrush="#CCCCCC" Margin="0,0,0,4"
                         TextChanged="filter_condition_changed_text"/>
                <TextBlock Text="複数指定は「,」区切り。いずれかの氏名を含む行が対象になります"
                           Style="{StaticResource NoteStyle}"/>

                <!-- 個人別集計モード -->
                <Border Background="#EEF4FB" CornerRadius="4" Padding="10,8"
                        Margin="0,4,0,8" BorderBrush="#CCDDF0" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="chk_single_mode"
                                  Content="個人別集計モード"
                                  FontSize="12" FontWeight="SemiBold"
                                  Foreground="#2E75B6"/>
                        <TextBlock Margin="20,4,0,0" FontSize="10" Foreground="#666"
                                   TextWrapping="Wrap"
                                   Text="ONにすると、指定した氏名ごとに daily_reports から直接集計します。その人の時間・人件費のみを正確に算出します。氏名フィルターとの併用が必要です。"/>
                    </StackPanel>
                </Border>

                <!-- ▼▼▼ 追加(B)：原価集計モード（1業務ごと＝1人ずつ） ▼▼▼ -->
                <Border Background="#EAF7F1" CornerRadius="4" Padding="10,8"
                        Margin="0,4,0,8" BorderBrush="#BFE3D2" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="chk_task_mode"
                                  Content="業務単位集計（担当者別）にする"
                                  FontSize="12" FontWeight="SemiBold"
                                  Foreground="#1F8A70"/>
                        <TextBlock Margin="20,4,0,0" FontSize="10" Foreground="#666"
                                   TextWrapping="Wrap"
                                   Text="ONにすると、日付×作業者×業務内容で1行に割って表示します（1人が1日3業務なら3行）。daily_reportsから都度集計し、cost_recordsは変更しません。"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="txt_error" Foreground="Red" FontSize="11"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ▼▼▼ 件数確認エリア（ボタン削除・件数表示のみ） ▼▼▼ -->
        <Border Grid.Row="2" Background="#EEF4FB"
                BorderBrush="#CCDDEE" BorderThickness="0,1,0,0"
                Padding="12,8">
            <TextBlock x:Name="txt_count_result"
                       Text="条件を入力すると件数を自動確認します"
                       FontSize="11" Foreground="#555"/>
        </Border>

        <!-- ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="90" Padding="0,7"
                    Margin="0,0,8,0" Click="btn_cancel_Click"/>
            <Button Content="タブを作成" Width="100" Padding="0,7"
                    Background="#2E75B6" Foreground="White"
                    Click="btn_create_Click"/>
        </StackPanel>
    </Grid>
</Window>
