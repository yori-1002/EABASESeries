<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EA_CostManager.Views.FirstLoginDialog"
        Title="ユーザー登録" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="btn_primary" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0" Text="ようこそ！ユーザー登録"
                   FontSize="18" FontWeight="Bold" Foreground="#1565C0"
                   Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,24"
                   FontSize="12" Foreground="#666">
            <Run Text="このPCにユーザーが登録されていません。"/>
            <LineBreak/>
            <Run Text="社員リストから氏名を選択するか、直接入力してください。"/>
        </TextBlock>

        <!-- 社員リストから選択 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="社員リストから選択" Style="{StaticResource label}"
                       FontWeight="SemiBold"/>
            <ComboBox x:Name="cmb_employees"
                      Height="36" FontSize="13"
                      SelectionChanged="cmb_employees_SelectionChanged"/>
        </StackPanel>

        <!-- 直接入力 -->
        <StackPanel Grid.Row="3">
            <TextBlock Margin="0,0,0,6">
                <Run Text="または直接入力" FontSize="12" FontWeight="SemiBold" Foreground="#444"/>
                <Run Text="（リストにない場合）" FontSize="11" Foreground="#888"/>
            </TextBlock>
            <Grid>
                <TextBox x:Name="txt_name"
                         Height="36" FontSize="13" Padding="8,0"
                         VerticalContentAlignment="Center"
                         TextChanged="txt_name_TextChanged"/>
                <TextBlock Text="氏名を入力してください"
                           FontSize="13" Foreground="#AAAAAA"
                           Margin="10,0,0,0" IsHitTestVisible="False"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txt_name}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>

        <!-- エラーメッセージ -->
        <TextBlock x:Name="lbl_error" Grid.Row="4"
                   Foreground="#E74C3C" FontSize="12"
                   VerticalAlignment="Bottom" Margin="0,0,0,8"/>

        <!-- ボタン -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="btn_register"
                    Content="登録して開始"
                    Style="{StaticResource btn_primary}"
                    Click="btn_register_Click"
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
