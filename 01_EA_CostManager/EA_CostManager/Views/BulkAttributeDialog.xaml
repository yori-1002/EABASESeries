<Window x:Class="EA_CostManager.Views.BulkAttributeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一括属性変更"
        Width="420"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource brush_bg_main}"
        FontFamily="Yu Gothic UI">

    <!-- ▼▼▼ ★v0.9.7追加：選択中の複数タブに対して共通の属性を一括設定するダイアログ ▼▼▼ -->
    <!-- iPhoneの写真複数選択→アクション適用のような操作感を提供する -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ヘッダー（件数表示） -->
            <RowDefinition Height="Auto"/>
            <!-- 対象タブ一覧 -->
            <RowDefinition Height="Auto"/>
            <!-- 属性選択ラベル -->
            <RowDefinition Height="Auto"/>
            <!-- 属性プルダウン -->
            <RowDefinition Height="*"/>
            <!-- スペーサー -->
            <RowDefinition Height="Auto"/>
            <!-- ボタン行 -->
        </Grid.RowDefinitions>

        <!-- ▼ 件数表示ヘッダー：「3件のタブの属性を変更します」のように表示する -->
        <TextBlock x:Name="txt_header"
                   Grid.Row="0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource brush_text_primary}"
                   Margin="0,0,0,10"/>

        <!-- ▼ 対象タブ一覧（最大4件まで表示、超える場合は「他N件」と省略する） -->
        <Border Grid.Row="1"
                Background="#F7FAFD"
                BorderBrush="#CCDDF0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8"
                Margin="0,0,0,16">
            <TextBlock x:Name="txt_target_list"
                       FontSize="11"
                       Foreground="{DynamicResource brush_text_secondary}"
                       TextWrapping="Wrap"
                       LineHeight="18"/>
        </Border>

        <!-- ▼ 属性選択ラベル -->
        <TextBlock Grid.Row="2"
                   Text="変更後の属性："
                   FontSize="12"
                   Foreground="{DynamicResource brush_text_primary}"
                   Margin="0,0,0,6"/>

        <!-- ▼ 属性プルダウン：CostPageの右クリックメニューと同じ7属性 -->
        <ComboBox x:Name="cmb_attribute"
                  Grid.Row="3"
                  Height="32"
                  FontSize="13"
                  Padding="6,4"
                  Margin="0,0,0,10">
            <ComboBoxItem Content="契約前"/>
            <ComboBoxItem Content="契約済"/>
            <ComboBoxItem Content="自社案件"/>
            <ComboBoxItem Content="第一土木"/>
            <ComboBoxItem Content="セミナー"/>
            <ComboBoxItem Content="追加"/>
            <ComboBoxItem Content="その他"/>
        </ComboBox>

        <!-- ▼ ボタン行：右寄せ（OK / キャンセル） -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="btn_cancel"
                    Content="キャンセル"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="btn_cancel_Click"/>
            <Button x:Name="btn_apply"
                    Content="一括適用"
                    Width="100"
                    Height="32"
                    Background="{DynamicResource brush_accent}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="btn_apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
