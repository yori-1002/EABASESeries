<UserControl x:Class="EA_CostManager.Views.MonthRangeCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>
		<Style x:Key="nav_btn" TargetType="Button">
			<Setter Property="Width"           Value="28"/>
			<Setter Property="Height"          Value="28"/>
			<Setter Property="FontSize"        Value="13"/>
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor"          Value="Hand"/>
			<Setter Property="Foreground"      Value="#2E75B6"/>
		</Style>
	</UserControl.Resources>

	<Border Background="#F8FBFF" CornerRadius="6"
            BorderBrush="#CCDDF0" BorderThickness="1" Padding="14,12">
		<StackPanel>

			<!-- 年選択 -->
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,0,0,10">
				<TextBlock Text="年度を選択：" FontSize="12" FontWeight="SemiBold"
                           Foreground="#1A3A5C" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
				<ComboBox x:Name="cmb_year" Width="100" FontSize="13"
                          Padding="6,4" SelectionChanged="cmb_year_SelectionChanged"/>
			</StackPanel>

			<!-- 選択中期間の表示 -->
			<Border Background="#EEF4FB" CornerRadius="4" Padding="10,6"
                    Margin="0,0,0,10" BorderBrush="#CCDDF0" BorderThickness="1">
				<TextBlock x:Name="txt_range_display"
                           Text="クリックして開始日を選択してください"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#5D6D7E"
                           HorizontalAlignment="Center"/>
			</Border>

			<!-- 2ヶ月カレンダー横並び -->
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- 左カレンダー -->
				<StackPanel Grid.Column="0">
					<Grid Margin="0,0,0,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="28"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="28"/>
						</Grid.ColumnDefinitions>
						<Button Grid.Column="0" x:Name="btn_prev_left"
                                Content="&#9664;" Style="{StaticResource nav_btn}"
                                Click="btn_prev_left_Click"/>
						<TextBlock Grid.Column="1" x:Name="txt_left_header"
                                   FontSize="13" FontWeight="Bold" Foreground="#1A3A5C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Button Grid.Column="2" x:Name="btn_next_left"
                                Content="&#9654;" Style="{StaticResource nav_btn}"
                                Click="btn_next_left_Click"/>
					</Grid>
					<UniformGrid x:Name="grid_left_header" Columns="7" Margin="0,0,0,2"/>
					<UniformGrid x:Name="grid_left" Columns="7"/>
				</StackPanel>

				<!-- 区切り線 -->
				<Rectangle Grid.Column="1" Width="1" Fill="#CCDDF0" VerticalAlignment="Stretch"/>

				<!-- 右カレンダー -->
				<StackPanel Grid.Column="2">
					<Grid Margin="0,0,0,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="28"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="28"/>
						</Grid.ColumnDefinitions>
						<Button Grid.Column="0" x:Name="btn_prev_right"
                                Content="&#9664;" Style="{StaticResource nav_btn}"
                                Click="btn_prev_right_Click"/>
						<TextBlock Grid.Column="1" x:Name="txt_right_header"
                                   FontSize="13" FontWeight="Bold" Foreground="#1A3A5C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Button Grid.Column="2" x:Name="btn_next_right"
                                Content="&#9654;" Style="{StaticResource nav_btn}"
                                Click="btn_next_right_Click"/>
					</Grid>
					<UniformGrid x:Name="grid_right_header" Columns="7" Margin="0,0,0,2"/>
					<UniformGrid x:Name="grid_right" Columns="7"/>
				</StackPanel>
			</Grid>

			<!-- クリア -->
			<StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
				<TextBlock Text="※ 1回目クリック：開始日　2回目クリック：終了日"
                           FontSize="10" Foreground="#888"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
				<Button x:Name="btn_clear" Content="クリア" Padding="10,4"
                        FontSize="11" Background="#E74C3C" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="btn_clear_Click"/>
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
